def app(a):
    opt = {c["id"]: c for c in CATALOG if c["optional"]}
    if a.act == "list":
        for r in snapshot():
            if r["optional"]: print(f"{r['id']:12}{'terpasang' if r['installed'] else 'belum':10}{r['version']}")
        return
    c = opt.get(a.id)
    if not c: die(f"aplikasi '{a.id}' tidak ada di katalog (opsional: {', '.join(opt)})")
    if c["id"] == "9router":
        nr_install() if a.act == "install" else nr_remove(); return
    installed = c["name"] in brew_versions()
    if a.act == "install":
        if installed: print(f"sudah terpasang: {c['label']}"); return
        if stream([BREW, "install", c["name"]]): die("brew install gagal")
        print(f"OK: {c['label']} terpasang. Jalankan dari halaman Aplikasi.")
    else:
        if not installed: print(f"belum terpasang: {c['label']}"); return
        sh([BREW, "services", "stop", c["name"]])
        if stream([BREW, "uninstall", c["name"]]): die("brew uninstall gagal")
        print(f"OK: {c['label']} dihapus")


