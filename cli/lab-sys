]
BY_ID = {c["id"]: c for c in CATALOG}


def tcp_ok(port):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.4): return True
    except OSError: return False


def unix_ok(path):
    try:
        c = socket.socket(socket.AF_UNIX); c.settimeout(0.4); c.connect(path); c.close(); return True
    except OSError: return False


def brew_versions():
    r = sh([BREW, "list", "--versions"])
    return {l.split()[0]: l.split()[-1] for l in r.stdout.splitlines() if l.strip()}


def brew_status():
    r = sh([BREW, "services", "list", "--json"])
    try: return {x["name"]: x.get("status") for x in json.loads(r.stdout or "[]")}
    except Exception: return {}


def probe(c):
    if c["port"]: return tcp_ok(c["port"])
    if c["sock"]: return unix_ok(c["sock"])
    if c["proc"]: return sh(["/usr/bin/pgrep", "-x", c["proc"]]).returncode == 0
    return False


def launchd_loaded(label):
    return sh(["/bin/launchctl", "print", f"gui/{UID}/{label}"]).returncode == 0


def snapshot():
    vers, bst, rows = brew_versions(), brew_status(), []
    for c in CATALOG:
        if c["kind"] == "brew": installed, ver = c["name"] in vers, vers.get(c["name"], "")
        else:
            installed, ver = (LAUNCH / f"{c['name']}.plist").exists(), ""
            if installed and c["id"] == "9router":
                try: ver = json.loads((NR_DIR / "node_modules/9router/package.json").read_text()).get("version", "")
                except (OSError, ValueError): pass
        if not installed: state = "not_installed"
        elif probe(c): state = "running"
        elif c["kind"] == "brew" and bst.get(c["name"]) == "error": state = "error"
        else: state = "stopped"
        rows.append(dict(id=c["id"], label=c["label"], group=c["group"], kind=c["kind"], version=ver, state=state, port=c["port"],
                         installed=installed, ctl=c["ctl"], optional=c["optional"], desc=c["desc"], has_log=bool(c["log"])))
    return rows


def service(a):
    if a.act == "list":
        rows = snapshot()
        if a.json: print(json.dumps(rows)); return
        for r in rows: print(f"{r['id']:14}{r['state']:15}{r['version']:10}{r['label']}")
        return
    c = BY_ID.get(a.id)
    if not c: die(f"layanan '{a.id}' tidak dikenal")
    if a.act == "logs":
        if not c["log"]: die("layanan ini tidak punya log yang bisa ditampilkan")
        import glob
        fs = sorted(glob.glob(c["log"]), key=os.path.getmtime)
        if not fs: die("log belum ada")
        n = max(1, min(int(a.n), 500))
        print(f"== {fs[-1]}"); print("\n".join(Path(fs[-1]).read_text(errors="replace").splitlines()[-n:])); return
    if not c["ctl"]: die(f"'{c['id']}' tidak bisa dikendalikan dari sini ({c['desc']})")
    if not snapshot_one(c)[0]: die(f"'{c['id']}' belum terpasang")
    if c["kind"] == "brew":
        extra = []
        if c["name"] == "mailpit" and a.act in ("start", "restart"): extra = [f"--file={mailpit_plist()}"]
        r = sh([BREW, "services", a.act, c["name"], *extra])
    else:
        plist = str(LAUNCH / f"{c['name']}.plist"); tgt = f"gui/{UID}/{c['name']}"
        if a.act == "restart": r = sh(["/bin/launchctl", "kickstart", "-k", tgt]) if launchd_loaded(c["name"]) else sh(["/bin/launchctl", "bootstrap", f"gui/{UID}", plist])
        elif a.act == "stop": r = sh(["/bin/launchctl", "bootout", tgt])
        else: r = sh(["/bin/launchctl", "bootstrap", f"gui/{UID}", plist]) if not launchd_loaded(c["name"]) else sh(["/bin/true"])
    if r.returncode: die((r.stderr or r.stdout).strip()[-300:] or "gagal")
    want = a.act != "stop"
    for _ in range(120 if c["id"] == "9router" else 20):  # 9router menyiapkan runtime SQLite saat start pertama (±20 dtk)
        time.sleep(0.5)
        if probe(c) == want: break
    now = probe(c)
    if now != want: die(f"perintah {a.act} dikirim, tetapi {c['label']} {'belum berjalan' if want else 'masih berjalan'}")
    print(f"OK: {c['label']} {'berjalan' if now else 'berhenti'}")


def mailpit_plist():
    """Plist bawaan Homebrew membuka Mailpit di semua antarmuka (LAN, tanpa login). Pakai plist sendiri yang terikat ke loopback."""
    import plistlib
    f = HOME / ".config/macminiops/mailpit.plist"
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_bytes(plistlib.dumps({"Label": "sh.brew.mailpit", "KeepAlive": True, "RunAtLoad": True,
        "ProgramArguments": ["/opt/homebrew/opt/mailpit/bin/mailpit", "--listen", "127.0.0.1:8025", "--smtp", "127.0.0.1:1025"],
        "StandardOutPath": "/opt/homebrew/var/log/mailpit.log", "StandardErrorPath": "/opt/homebrew/var/log/mailpit.log"}))
    os.chmod(f, 0o600)
    return str(f)


def snapshot_one(c):
    if c["kind"] == "brew": return (c["name"] in brew_versions(),)
    return ((LAUNCH / f"{c['name']}.plist").exists(),)


# ---------- 9Router (npm, launchd) ----------
NR_LABEL, NR_PORT = "com.macminiops.9router", 20128
