#!/usr/bin/env python3
"""lab: CLI kecil untuk environment lokal (mirip aaPanel). Modul saat ini: db.

  lab db list
  lab db create <nama> [--engine mysql|pgsql] [--env <file .env proyek>]
  lab db dump <nama> [--engine ...]            -> ~/Backups/db/<nama>-<waktu>.sql.gz
  lab db drop <nama> [--engine ...]            -> minta ketik ulang nama
  lab db restore <nama> [--engine ...] [--file <dump.sql.gz>]  -> ke database yang sudah ada DAN kosong; tanpa --file = dump terbaru
Aturan: satu database + satu user per proyek (nama sama), password acak tidak pernah dicetak,
disimpan di ~/.config/macminiops/projects/<nama>.<engine>.env (0600). Tanpa shell, argumen berupa list.
"""
import argparse, gzip, json, os, re, secrets, shutil, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
CRED = HOME / ".config/macminiops"
PROJ = CRED / "projects"
BK = HOME / "Backups/db"
MY = "/opt/homebrew/opt/mysql@8.4/bin/"
PG = "/opt/homebrew/opt/postgresql@17/bin/"
NAME_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
RESERVED = {"mysql", "sys", "information_schema", "performance_schema", "postgres", "template0", "template1", "root", "dev", "admin"}


def die(m):
    print("lab:", m, file=sys.stderr); sys.exit(1)


def load_root():
    env = {}
    for ln in (CRED / "db.env").read_text().splitlines():
        if "=" in ln and not ln.startswith("#"):
            k, v = ln.split("=", 1); env[k.strip()] = v.strip().strip("'\"")
    return env


def check_name(n):
    if not NAME_RE.match(n): die("nama harus huruf kecil/angka/_ , diawali huruf, maks 32 karakter")
    if n in RESERVED: die(f"nama '{n}' dicadangkan")


def my_run(sql=None, args=(), stdin=None, binary="mysql"):
    root = load_root()
    e = dict(os.environ, MYSQL_PWD=root["MYSQL_ROOT_PASSWORD"])
    cmd = [MY + binary, "-h127.0.0.1", "-uroot", *args]
    return subprocess.run(cmd, env=e, input=sql, text=True, capture_output=True, stdin=stdin)


def pg_run(sql=None, args=(), db="postgres", binary="psql"):
    root = load_root()
    e = dict(os.environ, PGPASSWORD=root["POSTGRES_PASSWORD"])
    cmd = [PG + binary, "-h127.0.0.1", "-Udev", "-v", "ON_ERROR_STOP=1", *args] if binary == "psql" else [PG + binary, "-h127.0.0.1", "-Udev", *args]
    if binary == "psql": cmd += ["-d", db]
    return subprocess.run(cmd, env=e, input=sql, text=True, capture_output=True)


def exists(engine, n):
    if engine == "mysql":
        r = my_run("SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name='%s'" % n, ["-N"])
    else:
        r = pg_run("SELECT COUNT(*) FROM pg_database WHERE datname='%s'" % n, ["-At"])
    if r.returncode: die(r.stderr.strip()[:200])
    return r.stdout.strip() == "1"


def cmd_list(a):
    print("MySQL:")
    r = my_run("SELECT schema_name FROM information_schema.schemata WHERE schema_name NOT IN ('information_schema','mysql','performance_schema','sys') ORDER BY 1", ["-N"])
    print("  " + (r.stdout.strip().replace("\n", "\n  ") or "(kosong)") if not r.returncode else r.stderr)
    print("PostgreSQL:")
    r = pg_run("SELECT datname FROM pg_database WHERE NOT datistemplate AND datname NOT IN ('postgres') ORDER BY 1", ["-At"])
    print("  " + (r.stdout.strip().replace("\n", "\n  ") or "(kosong)") if not r.returncode else r.stderr)


def write_env_file(path, kv):
    p = Path(path).expanduser()
    lines = p.read_text().splitlines() if p.exists() else []
    keys = {k for k in kv}
    lines = [l for l in lines if l.split("=", 1)[0] not in keys]
    lines += [f"{k}={v}" for k, v in kv.items()]
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text("\n".join(lines) + "\n"); os.chmod(p, 0o600)


def cmd_create(a):
    n, eng = a.name, a.engine; check_name(n)
    if exists(eng, n): die(f"database '{n}' sudah ada di {eng}")
    pw = secrets.token_urlsafe(24).replace("-", "x").replace("_", "y")
    if eng == "mysql":
        r = my_run(f"CREATE DATABASE `{n}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; "
                   f"CREATE USER '{n}'@'127.0.0.1' IDENTIFIED BY '{pw}'; CREATE USER '{n}'@'localhost' IDENTIFIED BY '{pw}'; "
                   f"GRANT ALL ON `{n}`.* TO '{n}'@'127.0.0.1'; GRANT ALL ON `{n}`.* TO '{n}'@'localhost';")
        port, conn = 3306, "mysql"
    else:
        r = pg_run(f'CREATE ROLE "{n}" LOGIN PASSWORD \'{pw}\'; GRANT "{n}" TO dev WITH SET TRUE; CREATE DATABASE "{n}" OWNER "{n}" ENCODING \'UTF8\'; REVOKE ALL ON DATABASE "{n}" FROM PUBLIC;')
        port, conn = 5432, "pgsql"
    if not r.returncode and eng == "pgsql":  # idempoten: user proyek tidak boleh konek ke database lain
        for d in ("dev", "postgres"): pg_run(f'REVOKE CONNECT ON DATABASE "{d}" FROM PUBLIC;')
    if r.returncode:
        cleanup(eng, n); die("gagal: " + r.stderr.strip()[:200])
    kv = {"DB_CONNECTION": conn, "DB_HOST": "127.0.0.1", "DB_PORT": str(port), "DB_DATABASE": n, "DB_USERNAME": n, "DB_PASSWORD": pw}
    PROJ.mkdir(parents=True, exist_ok=True); os.chmod(PROJ, 0o700)
    write_env_file(PROJ / f"{n}.{eng}.env", kv)
    print(f"OK: {eng} database+user '{n}' dibuat. Kredensial: {PROJ}/{n}.{eng}.env (0600)")
    if a.env:
        write_env_file(a.env, kv); print(f"DB_* ditulis ke {a.env} (0600). Pastikan file itu ada di .gitignore.")


def cleanup(eng, n):
    if eng == "mysql":
        my_run(f"DROP DATABASE IF EXISTS `{n}`; DROP USER IF EXISTS '{n}'@'127.0.0.1'; DROP USER IF EXISTS '{n}'@'localhost';")
    else:
        pg_run(f'DROP DATABASE IF EXISTS "{n}"; DROP ROLE IF EXISTS "{n}";')


def cmd_dump(a):
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die("database tidak ada")
    BK.mkdir(parents=True, exist_ok=True); os.chmod(BK, 0o700)
    out = BK / f"{n}-{eng}-{time.strftime('%Y%m%d-%H%M%S')}.sql.gz"
    if eng == "mysql":
        root = load_root(); e = dict(os.environ, MYSQL_PWD=root["MYSQL_ROOT_PASSWORD"])
        p = subprocess.run([MY + "mysqldump", "-h127.0.0.1", "-uroot", "--single-transaction", "--no-tablespaces", "--routines", "--events", n], env=e, capture_output=True)
    else:
        root = load_root(); e = dict(os.environ, PGPASSWORD=root["POSTGRES_PASSWORD"])
        p = subprocess.run([PG + "pg_dump", "-h127.0.0.1", "-Udev", n], env=e, capture_output=True)
    if p.returncode: die("dump gagal: " + p.stderr.decode()[:200])
    with gzip.open(out, "wb") as f: f.write(p.stdout)
    os.chmod(out, 0o600); print("OK:", out, f"({out.stat().st_size} byte)")


def cmd_drop(a):
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die("database tidak ada")
    if input(f"Hapus {eng} database dan user '{n}' PERMANEN. Ketik ulang namanya: ").strip() != n: die("nama tidak cocok, dibatalkan")
    a.engine = eng; cmd_dump(a)  # selalu dump dulu
    cleanup(eng, n)
    f = PROJ / f"{n}.{eng}.env"
    if f.exists(): f.unlink()
    print(f"OK: '{n}' dihapus (dump terakhir ada di {BK})")


def dump_files(n, eng):
    return sorted(BK.glob(f"{n}-{eng}-[0-9]*.sql.gz"), key=lambda f: f.name)


def table_count(eng, n):
    if eng == "mysql":
        r = my_run("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='%s'" % n, ["-N"])
    else:
        r = pg_run("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema NOT IN ('pg_catalog','information_schema')", ["-At"], db=n)
    if r.returncode: die("gagal memeriksa isi database: " + r.stderr.strip()[:200])
    return int(r.stdout.strip() or 0)


MAX_DUMP = 4 << 30  # batas ukuran setelah dekompresi
MY_WORD = re.compile(r"^\s*(system|source|tee|pager|edit|notee|nopager|\\)", re.I)
MY_BAD = re.compile(r"\\[!.PeT]")  # \! (shell), \. (source), \P (pager), \e (edit), \T (tee)
PG_OK = set("NntrbfvxX01234567.")
PG_SAFE_LINE = re.compile(r"^\\(un)?restrict \S+\s*$")
DEFINER = re.compile(r"DEFINER\s*=\s*(`[^`]*`|[^\s@]+)@(`[^`]*`|[^\s*]+)", re.I)
PG_STRIP = re.compile(r"^(ALTER .* OWNER TO |GRANT |REVOKE )", re.I)


class Reject(Exception): pass


def project_cred(n, eng):
    p = PROJ / f"{n}.{eng}.env"
    if not p.exists(): die(f"kredensial proyek {n} ({eng}) tidak ada; database harus dibuat dengan `lab db create`")
    kv = {}
    for ln in p.read_text().splitlines():
        if "=" in ln and not ln.startswith("#"): k, v = ln.split("=", 1); kv[k.strip()] = v.strip().strip("'\"")
    if not kv.get("DB_USERNAME") or not kv.get("DB_PASSWORD"): die("kredensial proyek tidak lengkap")
    return kv


def line_check(eng, s, no):
    t = s.replace("\\\\", "")  # pasangan backslash ganda bukan awal perintah
    if eng == "mysql":
        if MY_WORD.match(s) or MY_BAD.search(t): raise Reject(f"baris {no} memuat perintah klien MySQL yang tidak diizinkan (shell/berkas)")
    else:
        if PG_SAFE_LINE.match(s): return
        for m in re.finditer(r"\\(.?)", t):
            if m.group(1) not in PG_OK: raise Reject(f"baris {no} memuat meta-perintah psql yang tidak diizinkan (mis. shell atau copy berkas)")


def clean_lines(path, eng):
    """Alirkan dump per baris: periksa, hapus DEFINER (MySQL) dan OWNER/GRANT/REVOKE (PostgreSQL) yang butuh hak lebih tinggi."""
    total = 0
    with gzip.open(path, "rb") as g:
        no = 0
        while True:
            raw = g.readline(1 << 26)
            if not raw: break
            no += 1; total += len(raw)
            if total > MAX_DUMP: raise Reject("dump terlalu besar setelah dekompresi (>4 GB)")
            s = raw.decode("latin-1")
            line_check(eng, s, no)
            if eng == "mysql" and "DEFINER" in s.upper(): s = DEFINER.sub("", s)
            elif eng == "pgsql" and PG_STRIP.match(s): s = "\n"
            yield s.encode("latin-1")


def scan_dump(path, eng):
    try:
        for _ in clean_lines(path, eng): pass
    except Reject as e: die("dump ditolak: " + str(e))
    except (OSError, EOFError) as e: die("dump tidak bisa dibaca (bukan gzip yang valid?): " + str(e)[:80])


def cmd_restore(a):
    """Pulihkan dump ke database proyek yang sudah ada dan KOSONG. Tidak pernah menimpa data."""
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die(f"database '{n}' belum ada; buat dulu: lab db create {n} --engine {eng}")
    if a.file:
        f = Path(a.file)
        f = (BK / f.name) if f.parent in (Path("."), BK) else f
        try: f = f.resolve(strict=True)
        except OSError: die("berkas dump tidak ada")
        if f.parent != BK.resolve(): die("dump harus ada di ~/Backups/db")
        if not re.fullmatch(re.escape(n) + "-" + eng + r"-\d{8}-\d{6}\.sql\.gz", f.name): die(f"nama berkas harus {n}-{eng}-<tanggal>-<jam>.sql.gz (dump milik database ini)")
    else:
        fs = dump_files(n, eng)
        if not fs: die(f"tidak ada dump untuk '{n}' ({eng}) di {BK}")
        f = fs[-1]
    c = table_count(eng, n)
    if c: die(f"database '{n}' tidak kosong ({c} tabel); restore tidak menimpa data. Hapus isinya dulu atau pakai database baru")
    cred = project_cred(n, eng)  # dijalankan sebagai user proyek (hak hanya pada database itu), bukan root
    scan_dump(f, eng)  # tolak dump yang memuat perintah klien (shell, baca/tulis berkas) SEBELUM menyentuh database
    if eng == "mysql":
        e = dict(os.environ, MYSQL_PWD=cred["DB_PASSWORD"])
        cmd = [MY + "mysql", "-h127.0.0.1", "-u" + cred["DB_USERNAME"], n]
    else:
        e = dict(os.environ, PGPASSWORD=cred["DB_PASSWORD"])
        cmd = [PG + "psql", "-X", "-h127.0.0.1", "-U", cred["DB_USERNAME"], "-v", "ON_ERROR_STOP=1", "-q", "-d", n]
    pr = subprocess.Popen(cmd, env=e, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        for raw in clean_lines(f, eng): pr.stdin.write(raw)
    except (BrokenPipeError, OSError, EOFError): pass
    try: pr.stdin.close()
    except OSError: pass
    err = pr.stderr.read().decode(errors="replace"); rc = pr.wait()
    if rc:
        die("restore gagal: " + err.strip()[:300] + f" (database '{n}' mungkin terisi sebagian; hapus lalu buat ulang)")
    print(f"OK: {f.name} dipulihkan ke '{n}' ({table_count(eng, n)} tabel)")


def cmd_users(a):
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die("database tidak ada")
    if eng == "mysql": r = my_run(f"SELECT user,host FROM mysql.user WHERE user='{n}'", ["-N", "-B"])
    else: r = pg_run(f"SELECT rolname FROM pg_roles WHERE rolname='{n}'", ["-At"])
    if r.returncode: die("gagal membaca user: " + r.stderr.strip()[:200])
    rows = [ln.split("\t") for ln in r.stdout.splitlines() if ln.strip()]
    cf = PROJ / f"{n}.{eng}.env"
    print(json.dumps(dict(users=[dict(user=x[0], host=(x[1] if len(x) > 1 else "")) for x in rows], cred=cf.exists(), rotated=int(cf.stat().st_mtime) if cf.exists() else 0)))


def cmd_passwd(a):
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die("database tidak ada")
    kv = project_cred(n, eng)
    pw = secrets.token_urlsafe(24).replace("-", "x").replace("_", "y")
    if eng == "mysql": r = my_run(f"ALTER USER '{n}'@'127.0.0.1' IDENTIFIED BY '{pw}'; ALTER USER '{n}'@'localhost' IDENTIFIED BY '{pw}'; FLUSH PRIVILEGES;")
    else: r = pg_run(f"ALTER ROLE \"{n}\" PASSWORD '{pw}';")
    if r.returncode: die("ganti kata sandi gagal: " + r.stderr.strip()[:200])
    kv["DB_PASSWORD"] = pw
    write_env_file(PROJ / f"{n}.{eng}.env", kv)
    print(f"OK: kata sandi user '{n}' ({eng}) diganti dan disimpan di {PROJ}/{n}.{eng}.env. Perbarui .env aplikasi yang memakainya.")


def cmd_creds(a):
    n, eng = a.name, a.engine; check_name(n)
    print(json.dumps({k: v for k, v in project_cred(n, eng).items() if k.startswith("DB_")}))


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("worker", "job", "site", "php", "runtime", "update", "nginx", "service", "app", "ext", "ini", "composer", "deploy", "backup", "dbcfg", "sys"):
        os.execv(sys.executable, [sys.executable, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lab-svc" if sys.argv[1] in ("worker", "job") else "lab-dev" if sys.argv[1] in ("ext", "ini", "composer", "deploy", "backup", "dbcfg", "sys") else "lab-sys"), *sys.argv[1:]])
    ap = argparse.ArgumentParser(prog="lab"); sp = ap.add_subparsers(dest="mod", required=True)
    db = sp.add_parser("db").add_subparsers(dest="act", required=True)
    db.add_parser("list").set_defaults(f=cmd_list)
    for nm, fn in (("create", cmd_create), ("dump", cmd_dump), ("drop", cmd_drop), ("restore", cmd_restore), ("users", cmd_users), ("passwd", cmd_passwd), ("creds", cmd_creds)):
        p = db.add_parser(nm); p.add_argument("name"); p.add_argument("--engine", choices=["mysql", "pgsql"], default="mysql"); p.set_defaults(f=fn)
        if nm == "create": p.add_argument("--env")
        if nm == "restore": p.add_argument("--file")
    a = ap.parse_args(); a.f(a)


if __name__ == "__main__":
    main()
