#!/usr/bin/env python3
"""lab: CLI kecil untuk environment lokal (mirip aaPanel). Modul saat ini: db.

  lab db list
  lab db create <nama> [--engine mariadb|mysql|pgsql] [--env <file .env proyek>]
  lab db dump <nama> [--engine ...]            -> ~/MacPanel/backup/db/<nama>-<waktu>.sql.gz
  lab db drop <nama> [--engine ...]            -> minta ketik ulang nama
  lab db restore <nama> [--engine ...] [--file <dump.sql.gz>]  -> ke database yang sudah ada DAN kosong; tanpa --file = dump terbaru
Aturan: satu database + satu user per proyek (nama sama), password acak tidak pernah dicetak,
disimpan di ~/.config/macminiops/projects/<nama>.<engine>.env (0600). Tanpa shell, argumen berupa list.
"""
import argparse
import gzip
import json
import os
import re
import secrets
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
ROOT = Path(os.environ.get("MACPANEL_HOME") or (HOME / "MacPanel"))
CRED = HOME / ".config/macminiops"
PROJ = CRED / "projects"
BK = ROOT / "backup/db"
MY = "/opt/homebrew/opt/mysql@8.4/bin/"
MA = "/opt/homebrew/opt/mariadb@11.8/bin/"
# Keluarga MySQL: dua mesin terpisah. MariaDB memakai port bawaan 3306; MySQL 3307 (lihat my.cnf.d/10-local.cnf).
ENG = {
    "mariadb": dict(bin=MA, cli="mariadb", dump="mariadb-dump", port=3306, key="MARIADB_ROOT_PASSWORD", label="MariaDB"),
    "mysql": dict(bin=MY, cli="mysql", dump="mysqldump", port=3307, key="MYSQL_ROOT_PASSWORD", label="MySQL"),
}
ENGINES = list(ENG) + ["pgsql"]


def is_my(e): return e in ENG
PG = "/opt/homebrew/opt/postgresql@17/bin/"
NAME_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
RESERVED = {"mysql", "sys", "information_schema", "performance_schema", "postgres", "template0", "template1", "root", "dev", "admin"}


def die(m):
    print("lab:", m, file=sys.stderr); sys.exit(1)


def load_root():
    env = {}
    for ln in (CRED / "db.env").read_text().splitlines():
        if "=" in ln and not ln.startswith("#"):
            k, v = ln.split("=", 1); env[k.strip()] = v.strip().strip("'\"")
    return env


def check_name(n):
    if not NAME_RE.match(n): die("nama harus huruf kecil/angka/_ , diawali huruf, maks 32 karakter")
    if n in RESERVED: die(f"nama '{n}' dicadangkan")


def my_run(sql=None, args=(), stdin=None, binary="cli", eng="mysql"):
    root, g = load_root(), ENG[eng]
    if g["key"] not in root: die(f"kata sandi root {g['label']} tidak ada di db.env")
    e = dict(os.environ, MYSQL_PWD=root[g["key"]])
    cmd = [g["bin"] + g["dump" if binary == "dump" else "cli"], "-h127.0.0.1", f"-P{g['port']}", "-uroot", *args]
    return subprocess.run(cmd, env=e, input=sql, text=True, capture_output=True, stdin=stdin)


def pg_run(sql=None, args=(), db="postgres", binary="psql"):
    root = load_root()
    e = dict(os.environ, PGPASSWORD=root["POSTGRES_PASSWORD"])
    cmd = [PG + binary, "-h127.0.0.1", "-Udev", "-v", "ON_ERROR_STOP=1", *args] if binary == "psql" else [PG + binary, "-h127.0.0.1", "-Udev", *args]
    if binary == "psql": cmd += ["-d", db]
    return subprocess.run(cmd, env=e, input=sql, text=True, capture_output=True)


def exists(engine, n):
    if is_my(engine):
        r = my_run("SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name='%s'" % n, ["-N"], eng=engine)
    else:
        r = pg_run("SELECT COUNT(*) FROM pg_database WHERE datname='%s'" % n, ["-At"])
    if r.returncode: die(r.stderr.strip()[:200])
    return r.stdout.strip() == "1"


def cmd_list(a):
    for eng, g in ENG.items():
        print(g["label"] + ":")
        r = my_run("SELECT schema_name FROM information_schema.schemata WHERE schema_name NOT IN ('information_schema','mysql','performance_schema','sys') ORDER BY 1", ["-N"], eng=eng)
        print("  " + (r.stdout.strip().replace("\n", "\n  ") or "(kosong)") if not r.returncode else "  (tidak terjangkau: " + r.stderr.strip()[:80] + ")")
    print("PostgreSQL:")
    r = pg_run("SELECT datname FROM pg_database WHERE NOT datistemplate AND datname NOT IN ('postgres') ORDER BY 1", ["-At"])
    print("  " + (r.stdout.strip().replace("\n", "\n  ") or "(kosong)") if not r.returncode else r.stderr)


def write_env_file(path, kv):
    p = Path(path).expanduser()
    lines = p.read_text().splitlines() if p.exists() else []
    keys = {k for k in kv}
    lines = [l for l in lines if l.split("=", 1)[0] not in keys]
    lines += [f"{k}={v}" for k, v in kv.items()]
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text("\n".join(lines) + "\n"); os.chmod(p, 0o600)


def cmd_create(a):
    n, eng = a.name, a.engine; check_name(n)
    if exists(eng, n): die(f"database '{n}' sudah ada di {eng}")
    pw = secrets.token_urlsafe(24).replace("-", "x").replace("_", "y")
    if is_my(eng):
        r = my_run(f"CREATE DATABASE `{n}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; "
                   f"CREATE USER '{n}'@'127.0.0.1' IDENTIFIED BY '{pw}'; CREATE USER '{n}'@'localhost' IDENTIFIED BY '{pw}'; "
                   f"GRANT ALL ON `{n}`.* TO '{n}'@'127.0.0.1'; GRANT ALL ON `{n}`.* TO '{n}'@'localhost';", eng=eng)
        port, conn = ENG[eng]["port"], "mysql"  # driver 'mysql' juga dipahami MariaDB; sah untuk semua versi Laravel/WordPress
    else:
        r = pg_run(f'CREATE ROLE "{n}" LOGIN PASSWORD \'{pw}\'; GRANT "{n}" TO dev WITH SET TRUE; CREATE DATABASE "{n}" OWNER "{n}" ENCODING \'UTF8\'; REVOKE ALL ON DATABASE "{n}" FROM PUBLIC;')
        port, conn = 5432, "pgsql"
    if not r.returncode and eng == "pgsql":  # idempoten: user proyek tidak boleh konek ke database lain
        for d in ("dev", "postgres"): pg_run(f'REVOKE CONNECT ON DATABASE "{d}" FROM PUBLIC;')
    if r.returncode:
        cleanup(eng, n); die("gagal: " + r.stderr.strip()[:200])
    kv = {"DB_CONNECTION": conn, "DB_HOST": "127.0.0.1", "DB_PORT": str(port), "DB_DATABASE": n, "DB_USERNAME": n, "DB_PASSWORD": pw}
    PROJ.mkdir(parents=True, exist_ok=True); os.chmod(PROJ, 0o700)
    write_env_file(PROJ / f"{n}.{eng}.env", kv)
    print(f"OK: {eng} database+user '{n}' dibuat. Kredensial: {PROJ}/{n}.{eng}.env (0600)")
    if a.env:
        write_env_file(a.env, kv); print(f"DB_* ditulis ke {a.env} (0600). Pastikan file itu ada di .gitignore.")


def cleanup(eng, n):
    if is_my(eng):
        my_run(f"DROP DATABASE IF EXISTS `{n}`; DROP USER IF EXISTS '{n}'@'127.0.0.1'; DROP USER IF EXISTS '{n}'@'localhost';", eng=eng)
    else:
        pg_run(f'DROP DATABASE IF EXISTS "{n}"; DROP ROLE IF EXISTS "{n}";')


def cmd_dump(a):
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die("database tidak ada")
    BK.mkdir(parents=True, exist_ok=True); os.chmod(BK, 0o700)
    out = BK / f"{n}-{eng}-{time.strftime('%Y%m%d-%H%M%S')}.sql.gz"
    if is_my(eng):
        g = ENG[eng]; root = load_root(); e = dict(os.environ, MYSQL_PWD=root.get(g["key"], ""))
        extra = ["--no-tablespaces"] if eng == "mysql" else []
        p = subprocess.run([g["bin"] + g["dump"], "-h127.0.0.1", f"-P{g['port']}", "-uroot", "--single-transaction", *extra, "--routines", "--events", n], env=e, capture_output=True)
    else:
        root = load_root(); e = dict(os.environ, PGPASSWORD=root["POSTGRES_PASSWORD"])
        p = subprocess.run([PG + "pg_dump", "-h127.0.0.1", "-Udev", n], env=e, capture_output=True)
    if p.returncode: die("dump gagal: " + p.stderr.decode()[:200])
    with gzip.open(out, "wb") as f: f.write(p.stdout)
    os.chmod(out, 0o600); print("OK:", out, f"({out.stat().st_size} byte)")


def cmd_drop(a):
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die("database tidak ada")
    if input(f"Hapus {eng} database dan user '{n}' PERMANEN. Ketik ulang namanya: ").strip() != n: die("nama tidak cocok, dibatalkan")
    a.engine = eng; cmd_dump(a)  # selalu dump dulu
    purge_users(eng, n)
    cleanup(eng, n)
    f = PROJ / f"{n}.{eng}.env"
    if f.exists(): f.unlink()
    print(f"OK: '{n}' dihapus (dump terakhir ada di {BK})")


def dump_files(n, eng):
    return sorted(BK.glob(f"{n}-{eng}-[0-9]*.sql.gz"), key=lambda f: f.name)


def table_count(eng, n):
    if is_my(eng):
        r = my_run("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='%s'" % n, ["-N"], eng=eng)
    else:
        r = pg_run("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema NOT IN ('pg_catalog','information_schema')", ["-At"], db=n)
    if r.returncode: die("gagal memeriksa isi database: " + r.stderr.strip()[:200])
    return int(r.stdout.strip() or 0)


MAX_DUMP = 4 << 30  # batas ukuran setelah dekompresi
MY_WORD = re.compile(r"^\s*(system|source|tee|pager|edit|notee|nopager|\\)", re.I)
MY_BAD = re.compile(r"\\[!.PeT]")  # \! (shell), \. (source), \P (pager), \e (edit), \T (tee)
PG_OK = set("NntrbfvxX01234567.")
PG_SAFE_LINE = re.compile(r"^\\(un)?restrict \S+\s*$")
DEFINER = re.compile(r"DEFINER\s*=\s*(`[^`]*`|[^\s@]+)@(`[^`]*`|[^\s*]+)", re.I)
PG_STRIP = re.compile(r"^(ALTER .* OWNER TO |GRANT |REVOKE )", re.I)


class Reject(Exception): pass


def project_cred(n, eng):
    p = PROJ / f"{n}.{eng}.env"
    if not p.exists(): die(f"kredensial proyek {n} ({eng}) tidak ada; database harus dibuat dengan `lab db create`")
    kv = {}
    for ln in p.read_text().splitlines():
        if "=" in ln and not ln.startswith("#"): k, v = ln.split("=", 1); kv[k.strip()] = v.strip().strip("'\"")
    if not kv.get("DB_USERNAME") or not kv.get("DB_PASSWORD"): die("kredensial proyek tidak lengkap")
    return kv


def line_check(eng, s, no):
    t = s.replace("\\\\", "")  # pasangan backslash ganda bukan awal perintah
    if is_my(eng):
        if MY_WORD.match(s) or MY_BAD.search(t): raise Reject(f"baris {no} memuat perintah klien MySQL yang tidak diizinkan (shell/berkas)")
    else:
        if PG_SAFE_LINE.match(s): return
        for m in re.finditer(r"\\(.?)", t):
            if m.group(1) not in PG_OK: raise Reject(f"baris {no} memuat meta-perintah psql yang tidak diizinkan (mis. shell atau copy berkas)")


def clean_lines(path, eng):
    """Alirkan dump per baris: periksa, hapus DEFINER (MySQL) dan OWNER/GRANT/REVOKE (PostgreSQL) yang butuh hak lebih tinggi."""
    total = 0
    with gzip.open(path, "rb") as g:
        no = 0
        while True:
            raw = g.readline(1 << 26)
            if not raw: break
            no += 1; total += len(raw)
            if total > MAX_DUMP: raise Reject("dump terlalu besar setelah dekompresi (>4 GB)")
            s = raw.decode("latin-1")
            line_check(eng, s, no)
            if is_my(eng) and "DEFINER" in s.upper(): s = DEFINER.sub("", s)
            elif eng == "pgsql" and PG_STRIP.match(s): s = "\n"
            yield s.encode("latin-1")


def scan_dump(path, eng):
    try:
        for _ in clean_lines(path, eng): pass
    except Reject as e: die("dump ditolak: " + str(e))
    except (OSError, EOFError) as e: die("dump tidak bisa dibaca (bukan gzip yang valid?): " + str(e)[:80])


def cmd_restore(a):
    """Pulihkan dump ke database proyek yang sudah ada dan KOSONG. Tidak pernah menimpa data."""
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die(f"database '{n}' belum ada; buat dulu: lab db create {n} --engine {eng}")
    if a.file:
        f = Path(a.file)
        f = (BK / f.name) if f.parent in (Path("."), BK) else f
        try: f = f.resolve(strict=True)
        except OSError: die("berkas dump tidak ada")
        if f.parent != BK.resolve(): die("dump harus ada di ~/MacPanel/backup/db")
        if not re.fullmatch(re.escape(n) + "-" + eng + r"-\d{8}-\d{6}\.sql\.gz", f.name): die(f"nama berkas harus {n}-{eng}-<tanggal>-<jam>.sql.gz (dump milik database ini)")
    else:
        fs = dump_files(n, eng)
        if not fs: die(f"tidak ada dump untuk '{n}' ({eng}) di {BK}")
        f = fs[-1]
    c = table_count(eng, n)
    if c: die(f"database '{n}' tidak kosong ({c} tabel); restore tidak menimpa data. Hapus isinya dulu atau pakai database baru")
    cred = project_cred(n, eng)  # dijalankan sebagai user proyek (hak hanya pada database itu), bukan root
    scan_dump(f, eng)  # tolak dump yang memuat perintah klien (shell, baca/tulis berkas) SEBELUM menyentuh database
    if is_my(eng):
        g = ENG[eng]; e = dict(os.environ, MYSQL_PWD=cred["DB_PASSWORD"])
        cmd = [g["bin"] + g["cli"], "-h127.0.0.1", f"-P{g['port']}", "-u" + cred["DB_USERNAME"], n]
    else:
        e = dict(os.environ, PGPASSWORD=cred["DB_PASSWORD"])
        cmd = [PG + "psql", "-X", "-h127.0.0.1", "-U", cred["DB_USERNAME"], "-v", "ON_ERROR_STOP=1", "-q", "-d", n]
    pr = subprocess.Popen(cmd, env=e, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        for raw in clean_lines(f, eng): pr.stdin.write(raw)
    except (BrokenPipeError, OSError, EOFError): pass
    try: pr.stdin.close()
    except OSError: pass
    err = pr.stderr.read().decode(errors="replace"); rc = pr.wait()
    if rc:
        die("restore gagal: " + err.strip()[:300] + f" (database '{n}' mungkin terisi sebagian; hapus lalu buat ulang)")
    print(f"OK: {f.name} dipulihkan ke '{n}' ({table_count(eng, n)} tabel)")


def cmd_users(a):
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die("database tidak ada")
    if is_my(eng): r = my_run(f"SELECT user,host FROM mysql.user WHERE user='{n}'", ["-N", "-B"], eng=eng)
    else: r = pg_run(f"SELECT rolname FROM pg_roles WHERE rolname='{n}'", ["-At"])
    if r.returncode: die("gagal membaca user: " + r.stderr.strip()[:200])
    rows = [ln.split("\t") for ln in r.stdout.splitlines() if ln.strip()]
    cf = PROJ / f"{n}.{eng}.env"
    print(json.dumps(dict(users=[dict(user=x[0], host=(x[1] if len(x) > 1 else "")) for x in rows], cred=cf.exists(), rotated=int(cf.stat().st_mtime) if cf.exists() else 0)))


def cmd_passwd(a):
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die("database tidak ada")
    kv = project_cred(n, eng)
    chosen, pw = read_pw(a)
    if is_my(eng): r = my_run(f"ALTER USER '{n}'@'127.0.0.1' IDENTIFIED BY '{pw}'; ALTER USER '{n}'@'localhost' IDENTIFIED BY '{pw}'; FLUSH PRIVILEGES;", eng=eng)
    else: r = pg_run(f"ALTER ROLE \"{n}\" PASSWORD '{pw}';")
    if r.returncode: die("ganti kata sandi gagal: " + scrub_pw(r.stderr.strip()[:200], pw))
    kv["DB_PASSWORD"] = pw
    write_env_file(PROJ / f"{n}.{eng}.env", kv)
    print(f"OK: kata sandi user '{n}' ({eng}) diganti dan disimpan di {PROJ}/{n}.{eng}.env. Perbarui .env aplikasi yang memakainya.")


def cmd_creds(a):
    n, eng = a.name, a.engine; check_name(n)
    print(json.dumps({k: v for k, v in project_cred(n, eng).items() if k.startswith("DB_")}))


# ---------- user database tambahan, kata sandi root ----------
# Hanya user yang dibuat lewat perintah ini yang boleh diubah/dihapus (daftar di dbusers.json); akun lain tidak disentuh.
# Host dibatasi 127.0.0.1 dan localhost. Tidak ada hak global. Kata sandi pilihan sendiri dibaca dari stdin (tidak lewat argumen).
USERS_F = CRED / "dbusers.json"
UNAME_RE = re.compile(r"^[a-z][a-z0-9_]{2,31}$")
PW_RE = re.compile(r"^[A-Za-z0-9._+=:,@%^-]{12,100}$")  # aman untuk SQL, db.env yang di-source shell, dan argumen
PRIVS = ("ro", "rw", "all")
ROOT_KEYS = {"mariadb": "MARIADB_ROOT_PASSWORD", "mysql": "MYSQL_ROOT_PASSWORD", "pgsql": "POSTGRES_PASSWORD"}
SYSTEM_USERS = {"root", "mysql", "mariadb.sys", "mysql.sys", "mysql.session", "mysql.infoschema", "dev", "postgres", "admin", "mariadb", "public"}


def new_pw(): return secrets.token_urlsafe(24).replace("-", "x").replace("_", "y")


def read_pw(a):
    if not getattr(a, "password_stdin", False): return None, new_pw()
    pw = sys.stdin.readline().rstrip("\r\n")
    if not PW_RE.match(pw): die("kata sandi: 12-100 karakter dari huruf, angka, dan . _ + = : , @ % ^ -")
    return pw, pw


def scrub_pw(text, pw):
    return text.replace(pw, "***") if pw else text


def users_load():
    try: return json.loads(USERS_F.read_text())
    except (OSError, ValueError): return {}


def users_save(d):
    tmp = USERS_F.with_suffix(".tmp"); tmp.write_text(json.dumps(d, indent=1)); os.chmod(tmp, 0o600); os.replace(tmp, USERS_F)


def my_priv_sql(p):
    return {"ro": "SELECT, SHOW VIEW", "rw": "SELECT, INSERT, UPDATE, DELETE, SHOW VIEW, EXECUTE", "all": "ALL PRIVILEGES"}[p]


def pg_apply(db, u, p):
    """Atur ulang hak user PostgreSQL pada satu database (sebagai superuser dev)."""
    sq = f'REVOKE ALL ON ALL TABLES IN SCHEMA public FROM "{u}"; REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM "{u}"; ' \
         f'ALTER DEFAULT PRIVILEGES FOR ROLE "{db}" IN SCHEMA public REVOKE ALL ON TABLES FROM "{u}"; ' \
         f'ALTER DEFAULT PRIVILEGES FOR ROLE "{db}" IN SCHEMA public REVOKE ALL ON SEQUENCES FROM "{u}"; ' \
         f'REVOKE "{db}" FROM "{u}"; GRANT CONNECT ON DATABASE "{db}" TO "{u}"; GRANT USAGE ON SCHEMA public TO "{u}"; '
    if p == "ro":
        sq += f'GRANT SELECT ON ALL TABLES IN SCHEMA public TO "{u}"; ALTER DEFAULT PRIVILEGES FOR ROLE "{db}" IN SCHEMA public GRANT SELECT ON TABLES TO "{u}";'
    elif p == "rw":
        sq += f'GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO "{u}"; GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA public TO "{u}"; ' \
              f'ALTER DEFAULT PRIVILEGES FOR ROLE "{db}" IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO "{u}"; ' \
              f'ALTER DEFAULT PRIVILEGES FOR ROLE "{db}" IN SCHEMA public GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO "{u}";'
    else:
        sq += f'GRANT "{db}" TO "{u}" WITH INHERIT TRUE, SET TRUE;'
    return pg_run(sq, db=db)


def user_gate(eng, db, u, need_registered):
    check_name(db)
    if not exists(eng, db): die("database tidak ada")
    if not UNAME_RE.match(u) or u in RESERVED or u in SYSTEM_USERS: die("nama user: huruf kecil, angka, _; 3-32 karakter; bukan nama sistem")
    reg = users_load().get(f"{eng}/{u}")
    if need_registered:
        if not reg or reg["db"] != db: die("user ini tidak dikelola panel untuk database tersebut")
    return reg


def cmd_user_list(a):
    n, eng = a.name, a.engine; check_name(n)
    if not exists(eng, n): die("database tidak ada")
    out = [dict(user=n, host="127.0.0.1, localhost" if is_my(eng) else "127.0.0.1", privs="all", primary=True)]
    for k, v in sorted(users_load().items()):
        e, u = k.split("/", 1)
        if e == eng and v["db"] == n: out.append(dict(user=u, host="127.0.0.1, localhost" if is_my(eng) else "127.0.0.1", privs=v["privs"], primary=False, created=v.get("created", 0)))
    print(json.dumps(dict(users=out, port=ENG[eng]["port"] if is_my(eng) else 5432)))


def cmd_user_add(a):
    n, eng, u, p = a.name, a.engine, a.user, a.privs
    if user_gate(eng, n, u, False): die("user sudah ada")
    if exists(eng, u): die("nama itu dipakai database proyek lain")
    chosen, pw = read_pw(a)
    if is_my(eng):
        r = my_run(f"SELECT COUNT(*) FROM mysql.user WHERE user='{u}'", ["-N"], eng=eng)
        if r.returncode or r.stdout.strip() != "0": die("user dengan nama itu sudah ada di server (bukan buatan panel)")
        g = my_priv_sql(p)
        r = my_run(f"CREATE USER '{u}'@'127.0.0.1' IDENTIFIED BY '{pw}'; CREATE USER '{u}'@'localhost' IDENTIFIED BY '{pw}'; "
                   f"GRANT {g} ON `{n}`.* TO '{u}'@'127.0.0.1'; GRANT {g} ON `{n}`.* TO '{u}'@'localhost'; FLUSH PRIVILEGES;", eng=eng)
    else:
        r = pg_run(f"SELECT COUNT(*) FROM pg_roles WHERE rolname='{u}'", ["-At"])
        if r.returncode or r.stdout.strip() != "0": die("role dengan nama itu sudah ada di server (bukan buatan panel)")
        r = pg_run(f'CREATE ROLE "{u}" LOGIN PASSWORD \'{pw}\'; GRANT "{u}" TO dev WITH SET TRUE;')  # dev bukan superuser: butuh keanggotaan agar bisa mengelola/menghapusnya
        if not r.returncode: r = pg_apply(n, u, p)
    if r.returncode:
        (my_run(f"DROP USER IF EXISTS '{u}'@'127.0.0.1'; DROP USER IF EXISTS '{u}'@'localhost';", eng=eng) if is_my(eng) else pg_run(f'DROP ROLE IF EXISTS "{u}";'))
        die("gagal membuat user: " + scrub_pw(r.stderr.strip()[:200], pw))
    d = users_load(); d[f"{eng}/{u}"] = dict(db=n, privs=p, created=int(time.time())); users_save(d)
    res = dict(ok=True, user=u, db=n, privs=p, host="127.0.0.1", port=ENG[eng]["port"] if is_my(eng) else 5432)
    if not chosen: res["password"] = pw
    print(json.dumps(res))


def cmd_user_passwd(a):
    n, eng, u = a.name, a.engine, a.user
    user_gate(eng, n, u, True)
    chosen, pw = read_pw(a)
    if is_my(eng): r = my_run(f"ALTER USER '{u}'@'127.0.0.1' IDENTIFIED BY '{pw}'; ALTER USER '{u}'@'localhost' IDENTIFIED BY '{pw}'; FLUSH PRIVILEGES;", eng=eng)
    else: r = pg_run(f'ALTER ROLE "{u}" PASSWORD \'{pw}\';')
    if r.returncode: die("gagal mengganti kata sandi: " + scrub_pw(r.stderr.strip()[:200], pw))
    res = dict(ok=True, user=u)
    if not chosen: res["password"] = pw
    print(json.dumps(res))


def cmd_user_privs(a):
    n, eng, u, p = a.name, a.engine, a.user, a.privs
    user_gate(eng, n, u, True)
    if is_my(eng):
        g = my_priv_sql(p); sq = ""
        for h in ("127.0.0.1", "localhost"): sq += f"REVOKE ALL PRIVILEGES ON `{n}`.* FROM '{u}'@'{h}'; GRANT {g} ON `{n}`.* TO '{u}'@'{h}'; "
        r = my_run(sq + "FLUSH PRIVILEGES;", eng=eng)
    else: r = pg_apply(n, u, p)
    if r.returncode: die("gagal mengubah hak: " + r.stderr.strip()[:200])
    d = users_load(); d[f"{eng}/{u}"]["privs"] = p; users_save(d)
    print(json.dumps(dict(ok=True, user=u, privs=p)))


def drop_user(eng, db, u):
    if is_my(eng): r = my_run(f"DROP USER IF EXISTS '{u}'@'127.0.0.1'; DROP USER IF EXISTS '{u}'@'localhost'; FLUSH PRIVILEGES;", eng=eng)
    else:
        r = pg_run(f'DROP OWNED BY "{u}";', db=db)
        if not r.returncode: r = pg_run(f'DROP ROLE IF EXISTS "{u}";')
    return r


def cmd_user_remove(a):
    n, eng, u = a.name, a.engine, a.user
    user_gate(eng, n, u, True)
    r = drop_user(eng, n, u)
    if r.returncode: die("gagal menghapus user: " + r.stderr.strip()[:200])
    d = users_load(); d.pop(f"{eng}/{u}", None); users_save(d)
    print(json.dumps(dict(ok=True, user=u)))


def purge_users(eng, db):
    d = users_load(); ch = False
    for k, v in list(d.items()):
        e, u = k.split("/", 1)
        if e == eng and v["db"] == db:
            if drop_user(eng, db, u).returncode: die(f"gagal menghapus user '{u}'; database tidak dihapus")
            d.pop(k); ch = True
    if ch: users_save(d)


def sql_as(eng, pw, sql):
    """Jalankan SQL sebagai root dengan kata sandi eksplisit (bukan dari db.env)."""
    if is_my(eng):
        g = ENG[eng]
        return subprocess.run([g["bin"] + g["cli"], "-h127.0.0.1", f"-P{g['port']}", "-uroot", "-N", "-e", sql], env=dict(os.environ, MYSQL_PWD=pw), text=True, capture_output=True)
    return subprocess.run([PG + "psql", "-h127.0.0.1", "-Udev", "-d", "postgres", "-At", "-v", "ON_ERROR_STOP=1", "-c", sql], env=dict(os.environ, PGPASSWORD=pw), text=True, capture_output=True)


def write_root_env(key, val):
    p = CRED / "db.env"; old = p.read_text()
    bak = CRED / f"db.env.bak.{time.strftime('%Y%m%d-%H%M%S')}"; bak.write_text(old); os.chmod(bak, 0o600)
    for b in sorted(CRED.glob("db.env.bak.*"))[:-2]: b.unlink()  # simpan 2 terakhir saja (memuat sandi lama)
    lines = [l for l in old.splitlines() if l.split("=", 1)[0] != key] + [f"{key}={val}"]
    tmp = CRED / "db.env.tmp"; tmp.write_text("\n".join(lines) + "\n"); os.chmod(tmp, 0o600); os.replace(tmp, p)


def cmd_root_passwd(a):
    eng = a.engine; key = ROOT_KEYS[eng]
    cur = load_root().get(key)
    if not cur: die(f"{key} tidak ada di db.env")
    if sql_as(eng, cur, "SELECT 1").returncode: die("kata sandi root saat ini di db.env tidak cocok dengan server; tidak diubah")
    chosen, pw = read_pw(a)
    if pw == cur: die("kata sandi baru sama dengan yang lama")
    if is_my(eng):
        r = sql_as(eng, cur, f"ALTER USER 'root'@'localhost' IDENTIFIED BY '{pw}'; " + ("ALTER USER 'root'@'127.0.0.1' IDENTIFIED BY '%s'; " % pw if eng == "mariadb" else "") + "FLUSH PRIVILEGES;")
    else: r = sql_as(eng, cur, f"ALTER ROLE dev PASSWORD '{pw}'")
    if r.returncode: die("gagal mengganti kata sandi root (tidak berubah): " + scrub_pw(r.stderr.strip()[:200], pw))
    write_root_env(key, pw)
    if sql_as(eng, pw, "SELECT 1").returncode:  # tidak bisa masuk dengan sandi baru: kembalikan
        write_root_env(key, cur)
        die("verifikasi sandi baru gagal; db.env dikembalikan. Periksa server database sebelum mencoba lagi")
    res = dict(ok=True, engine=eng)
    if not chosen: res["password"] = pw
    print(json.dumps(res))


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("worker", "job", "site", "php", "runtime", "update", "nginx", "service", "app", "ext", "ini", "composer", "deploy", "backup", "dbcfg", "sys", "redis", "appinstall", "siteclone", "docker"):
        os.execv(sys.executable, [sys.executable, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lab-svc" if sys.argv[1] in ("worker", "job") else "lab-docker" if sys.argv[1] == "docker" else "lab-dev" if sys.argv[1] in ("ext", "ini", "composer", "deploy", "backup", "dbcfg", "sys", "redis", "appinstall", "siteclone") else "lab-sys"), *sys.argv[1:]])
    ap = argparse.ArgumentParser(prog="lab"); sp = ap.add_subparsers(dest="mod", required=True)
    db = sp.add_parser("db").add_subparsers(dest="act", required=True)
    db.add_parser("list").set_defaults(f=cmd_list)
    for nm, fn in (("create", cmd_create), ("dump", cmd_dump), ("drop", cmd_drop), ("restore", cmd_restore), ("users", cmd_users), ("passwd", cmd_passwd), ("creds", cmd_creds)):
        p = db.add_parser(nm); p.add_argument("name"); p.add_argument("--engine", choices=ENGINES, default="mariadb"); p.set_defaults(f=fn)
        if nm == "create": p.add_argument("--env")
        if nm == "restore": p.add_argument("--file")
        if nm == "passwd": p.add_argument("--password-stdin", action="store_true")
    du = db.add_parser("user").add_subparsers(dest="uact", required=True)
    for nm, fn in (("list", cmd_user_list), ("add", cmd_user_add), ("passwd", cmd_user_passwd), ("privs", cmd_user_privs), ("remove", cmd_user_remove)):
        p = du.add_parser(nm); p.add_argument("name"); p.add_argument("--engine", choices=ENGINES, default="mariadb"); p.set_defaults(f=fn)
        if nm != "list": p.add_argument("user")
        if nm in ("add", "privs"): p.add_argument("--privs", choices=PRIVS, required=True)
        if nm in ("add", "passwd"): p.add_argument("--password-stdin", action="store_true")
    p = db.add_parser("root-passwd"); p.add_argument("--engine", choices=ENGINES, required=True); p.add_argument("--password-stdin", action="store_true"); p.set_defaults(f=cmd_root_passwd)
    a = ap.parse_args(); a.f(a)


if __name__ == "__main__":
    main()
