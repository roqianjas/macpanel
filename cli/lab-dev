#!/usr/bin/env python3
"""lab ext | ini | composer | deploy | backup  (dispatch dari `lab`)

  lab ext list <php>                         JSON: ekstensi bawaan + ekstensi yang bisa dipasang (PECL)
  lab ext install|remove|enable|disable <php> <nama>
  lab ini get <php>                          JSON: nilai pool FPM yang boleh diubah
  lab ini set <php> <kunci>=<nilai> [...]    uji php-fpm -t, restart FPM, kembalikan bila gagal
  lab composer status                        JSON
  lab composer install | update              (brew install/upgrade composer)
  lab composer run <situs> <install|install-nodev|update|dump-autoload|validate>
  lab deploy info <situs>                    JSON: langkah yang tersedia untuk proyek situs itu
  lab deploy run <situs> <langkah[,langkah]>
  lab backup list                            JSON
  lab backup run
Tanpa shell: semua argumen list; nama, versi, kunci, dan nilai divalidasi.
"""
import argparse, json, os, re, shutil, socket, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
OPS = HOME / "Developer/_ops"
BREW = "/opt/homebrew/bin/brew"
MISE = "/opt/homebrew/bin/mise"
COMPOSER = "/opt/homebrew/bin/composer"
ENV = dict(os.environ, PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin", HOMEBREW_NO_AUTO_UPDATE="1", HOMEBREW_CURL_RETRIES="5")
PHPS = ["8.2", "8.3", "8.4", "8.5"]
SITES = OPS / "web/nginx/sites"
NAME_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$")
PROTECTED = {"home", "nginx", "db", "kuma", "stats", "hello", "panel"}


def die(m):
    print("lab:", m, file=sys.stderr); sys.exit(1)


def sh(cmd, **kw):
    env = kw.pop("env", ENV)
    return subprocess.run(cmd, env=env, text=True, capture_output=True, **kw)


def stream(cmd, cwd=None, env=None, stdin=None):
    return subprocess.run(cmd, env=env or ENV, cwd=cwd, stdin=stdin).returncode


def formula(v): return "php" if v == "8.5" else f"php@{v}"
def php_home(v): return Path(f"/opt/homebrew/opt/{formula(v)}")
def php_bin(v): return str(php_home(v) / "bin/php")
def conf_dir(v): return Path(f"/opt/homebrew/etc/php/{v}")
def sock(v): return Path(f"/opt/homebrew/var/run/php-fpm-dev-{v}.sock")


def need_php(v):
    if v not in PHPS: die(f"versi PHP: {', '.join(PHPS)}")
    if not php_home(v).exists(): die(f"PHP {v} belum terpasang")


def sock_ok(v):
    try:
        c = socket.socket(socket.AF_UNIX); c.settimeout(1); c.connect(str(sock(v))); c.close(); return True
    except OSError:
        return False


def restart_fpm(v):
    """Restart FPM dan tunggu socket benar-benar menjawab (bukan hanya `brew services` bilang started)."""
    sh([BREW, "services", "restart", formula(v)])
    for _ in range(20):
        time.sleep(0.5)
        if sock_ok(v): return True
    return False


# ---------- ext ----------
# Hanya ekstensi yang sudah diuji pasang di mesin ini.
EXTS = {
    "redis": dict(label="Redis (phpredis)", zend=False, brew=[]),
    "apcu": dict(label="APCu (cache memori)", zend=False, brew=["pcre2"]),
    "xdebug": dict(label="Xdebug", zend=True, brew=[], ini=["xdebug.mode=develop,debug"]),
    "imagick": dict(label="ImageMagick (imagick)", zend=False, brew=["pkgconf", "imagemagick"], cfg='with-imagick="/opt/homebrew/opt/imagemagick"'),
    "igbinary": dict(label="igbinary (serialisasi cepat)", zend=False, brew=[]),
    "msgpack": dict(label="MessagePack", zend=False, brew=[]),
    "pcov": dict(label="PCOV (code coverage)", zend=False, brew=[]),
    "yaml": dict(label="YAML", zend=False, brew=["libyaml"], cfg='with-yaml="/opt/homebrew/opt/libyaml"'),
    "memcached": dict(label="Memcached (klien)", zend=False, brew=["libmemcached", "zlib"],
                      cfg='enable-memcached-session="yes" enable-memcached-igbinary="no" enable-memcached-msgpack="no" enable-memcached-json="no" with-libmemcached-dir="/opt/homebrew/opt/libmemcached" with-zlib-dir="/opt/homebrew/opt/zlib" enable-memcached-sasl="no" with-system-fastlz="no" enable-memcached-protocol="no"'),
    "mongodb": dict(label="MongoDB", zend=False, brew=["openssl@3"], cfg='with-mongodb-system-libs="no" with-mongodb-ssl="openssl" with-mongodb-sasl="no" with-mongodb-client-side-encryption="no"'),
}


def ext_dir(v):
    r = sh([php_bin(v), "-r", "echo ini_get('extension_dir');"])
    return Path(r.stdout.strip())


def modules(v):
    out = sh([php_bin(v), "-m"]).stdout
    return [l.strip() for l in out.splitlines() if l.strip() and not l.startswith("[")]


def ext_ini(v, n): return conf_dir(v) / "conf.d" / f"ext-lab-{n}.ini"


def ext_list(v):
    need_php(v)
    mods = modules(v); low = {m.lower() for m in mods}
    ed = ext_dir(v); managed = []
    for n, c in EXTS.items():
        on, off = ext_ini(v, n), Path(str(ext_ini(v, n)) + ".disabled")
        managed.append(dict(name=n, label=c["label"], installed=(ed / f"{n}.so").exists(), enabled=on.exists(), loaded=n in low, zend=c["zend"]))
    builtin = sorted({m for m in mods if m.lower() not in EXTS}, key=str.lower)
    print(json.dumps(dict(version=v, builtin=builtin, managed=managed)))


def strip_pecl_ini_lines(v, n):
    """`pecl install` menyisipkan extension="x.so" ke php.ini; pindahkan ke conf.d agar bisa dimatikan satu per satu."""
    p = conf_dir(v) / "php.ini"
    if not p.exists(): return
    pat = re.compile(rf'^\s*(zend_)?extension\s*=\s*"?{re.escape(n)}(\.so)?"?\s*$')
    lines = p.read_text().splitlines(keepends=True)
    keep = [l for l in lines if not pat.match(l.strip())]
    if len(keep) != len(lines):
        shutil.copy2(p, f"{p}.bak.{time.strftime('%Y%m%d-%H%M%S')}")
        p.write_text("".join(keep))


def write_ext_ini(v, n):
    c = EXTS[n]
    d = conf_dir(v) / "conf.d"; d.mkdir(parents=True, exist_ok=True)
    key = "zend_extension" if c["zend"] else "extension"
    ini = ext_ini(v, n); ini.write_text(f"; Dikelola `lab ext`. Hapus lewat panel atau `lab ext remove`.\n{key}={n}.so\n" + "".join(x + "\n" for x in c.get("ini", [])))
    Path(str(ini) + ".disabled").unlink(missing_ok=True)


def ext_act(a):
    v, n = a.php, a.name
    need_php(v)
    if n not in EXTS: die(f"ekstensi yang didukung: {', '.join(EXTS)}")
    ini = ext_ini(v, n); off = Path(str(ini) + ".disabled")
    if a.act == "install":
        if not (ext_dir(v) / f"{n}.so").exists():
            for b in EXTS[n]["brew"]:
                if sh([BREW, "list", "--versions", b]).stdout.strip(): continue
                print(f"memasang dependensi {b} ...", flush=True)
                for i in range(4):
                    if stream([BREW, "install", b]) == 0: break
                    print(f"brew install {b}: percobaan {i + 1} gagal, ulangi...", flush=True); time.sleep(8)
                else: die(f"brew install {b} gagal setelah 4 percobaan (jaringan?)")
            pecl = str(php_home(v) / "bin/pecl")
            env = dict(ENV, PKG_CONFIG_PATH="/opt/homebrew/lib/pkgconfig:/opt/homebrew/share/pkgconfig", CPPFLAGS="-I/opt/homebrew/include", CFLAGS="-I/opt/homebrew/include", LDFLAGS="-L/opt/homebrew/lib")
            for i in range(3):
                r = subprocess.run([pecl, "install", "-f"] + ([f"--configureoptions={EXTS[n]['cfg']}"] if EXTS[n].get("cfg") else []) + [n], env=env, input="\n" * 10, text=True, capture_output=True)
                if r.returncode == 0 and (ext_dir(v) / f"{n}.so").exists(): break
                errs = [l.strip()[:200] for l in (r.stdout + r.stderr).splitlines() if re.search(r"error|fatal|not found", l, re.I)][-4:]
                print(f"percobaan {i + 1} gagal: {' | '.join(errs) or (r.stdout + r.stderr).strip()[-200:]}", flush=True); time.sleep(5)
            else: die("pecl install gagal (penyebab di atas)")
        strip_pecl_ini_lines(v, n)
        write_ext_ini(v, n)
    elif a.act == "enable":
        if not (ext_dir(v) / f"{n}.so").exists(): die(f"{n} belum terpasang di PHP {v}")
        write_ext_ini(v, n)
    elif a.act == "disable":
        if not ini.exists(): die(f"{n} sudah nonaktif atau belum terpasang")
        off.unlink(missing_ok=True); ini.rename(off)
    elif a.act == "remove":
        ini.unlink(missing_ok=True); off.unlink(missing_ok=True)
        so = ext_dir(v) / f"{n}.so"
        if so.exists():
            r = sh([str(php_home(v) / "bin/pecl"), "uninstall", n], input="")
            strip_pecl_ini_lines(v, n)
            if so.exists(): so.unlink()
    ok = restart_fpm(v)
    mods = {m.lower() for m in modules(v)}
    want = a.act in ("install", "enable")
    if want and n not in mods:
        ini.unlink(missing_ok=True); restart_fpm(v); die(f"{n} tidak termuat di PHP {v}; perubahan dibatalkan")
    if not want and n in mods: die(f"{n} masih termuat di PHP {v}")
    if not ok: die(f"FPM {v} tidak menjawab setelah restart; periksa log")
    print(f"OK: {n} {a.act} pada PHP {v}; FPM dimulai ulang dan {'termuat' if want else 'tidak termuat'} (php -m)")


# ---------- ini (pool FPM) ----------
SIZE = re.compile(r"^\d{1,5}[KMG]$")
INT = re.compile(r"^(-1|\d{1,6})$")
INI_KEYS = {
    "memory_limit": (lambda s: s == "-1" or SIZE.match(s), "mis. 512M, 2G, atau -1"),
    "upload_max_filesize": (lambda s: SIZE.match(s), "mis. 64M"),
    "post_max_size": (lambda s: SIZE.match(s), "mis. 64M"),
    "max_execution_time": (lambda s: INT.match(s), "detik, 0 = tanpa batas"),
    "max_input_time": (lambda s: INT.match(s), "detik"),
    "max_input_vars": (lambda s: re.fullmatch(r"\d{3,6}", s), "mis. 3000"),
    "display_errors": (lambda s: s in ("0", "1"), "0 atau 1"),
    "date.timezone": (lambda s: re.fullmatch(r"[A-Za-z0-9_+/-]{1,40}", s), "mis. Asia/Jakarta"),
}


POOL_KEYS = {
    "pm": (lambda s: s in ("static", "dynamic", "ondemand"), "static, dynamic, atau ondemand"),
    "pm.max_children": (lambda s: re.fullmatch(r"\d{1,3}", s) and 1 <= int(s) <= 200, "1-200 proses"),
    "pm.start_servers": (lambda s: re.fullmatch(r"\d{1,3}", s) and 1 <= int(s) <= 200, "mode dynamic: proses awal"),
    "pm.min_spare_servers": (lambda s: re.fullmatch(r"\d{1,3}", s) and 1 <= int(s) <= 200, "mode dynamic: minimum menganggur"),
    "pm.max_spare_servers": (lambda s: re.fullmatch(r"\d{1,3}", s) and 1 <= int(s) <= 200, "mode dynamic: maksimum menganggur"),
    "pm.process_idle_timeout": (lambda s: re.fullmatch(r"\d{1,4}s", s), "mode ondemand, mis. 30s"),
    "pm.max_requests": (lambda s: re.fullmatch(r"\d{1,6}", s) and int(s) <= 100000, "0 = tanpa daur ulang"),
}


def pool_file(v): return conf_dir(v) / "php-fpm.d/dev.conf"


def pool_values(v):
    vals = {}
    p = pool_file(v)
    if p.exists():
        for l in p.read_text().splitlines():
            m = re.match(r"^php_admin_value\[([a-z_.]+)\]\s*=\s*(\S.*?)\s*$", l)
            if m: vals[m.group(1)] = m.group(2)
            m = re.match(r"^(pm(?:\.[a-z_]+)?)\s*=\s*(\S.*?)\s*$", l)
            if m and m.group(1) in POOL_KEYS: vals[m.group(1)] = m.group(2)
    return vals


def ini_get(v):
    need_php(v)
    cur = pool_values(v); rows = []
    for k, (_, hint) in INI_KEYS.items():
        eff = sh([php_bin(v), "-n", "-r", f"echo ini_get('{k}');"]).stdout.strip()
        rows.append(dict(key=k, value=cur.get(k, ""), default=eff, hint=hint, group="php"))
    for k, (_, hint) in POOL_KEYS.items():
        rows.append(dict(key=k, value=cur.get(k, ""), default="", hint=hint, group="fpm"))
    print(json.dumps(dict(version=v, keys=rows)))


def tz_ok(v, tz):
    return sh([php_bin(v), "-n", "-r", "exit(@timezone_open($argv[1]) ? 0 : 1);", "--", tz]).returncode == 0


def ini_set(a):
    v = a.php; need_php(v)
    pairs = {}
    for kv in a.pairs:
        if "=" not in kv: die(f"format kunci=nilai: {kv!r}")
        k, val = kv.split("=", 1)
        if k in POOL_KEYS:
            if not POOL_KEYS[k][0](val): die(f"nilai {k} tidak valid ({POOL_KEYS[k][1]})")
            pairs[k] = val; continue
        if k not in INI_KEYS: die(f"kunci tidak didukung: {k!r} (boleh: {', '.join(list(INI_KEYS) + list(POOL_KEYS))})")
        if not INI_KEYS[k][0](val): die(f"nilai {k} tidak valid ({INI_KEYS[k][1]})")
        if k == "date.timezone" and not tz_ok(v, val): die("zona waktu tidak dikenal PHP")
        pairs[k] = val
    p = pool_file(v)
    if not p.exists(): die(f"{p} tidak ada; jalankan `lab php install {v}`")
    old = p.read_text(); bak = f"{p}.bak.{time.strftime('%Y%m%d-%H%M%S')}"
    new = old if old.endswith("\n") else old + "\n"
    for k, val in pairs.items():
        if k in POOL_KEYS:
            pat = re.compile(rf"^{re.escape(k)}\s*=.*$", re.M); line = f"{k} = {val}"
        else:
            pat = re.compile(rf"^php_admin_value\[{re.escape(k)}\]\s*=.*$", re.M)
            line = f"php_admin_value[{k}] = {val}"
        new = pat.sub(line, new, count=1) if pat.search(new) else new + line + "\n"
    eff = {}
    for l in new.splitlines():
        m = re.match(r"^(pm(?:\.[a-z_]+)?)\s*=\s*(\S+)", l)
        if m and m.group(1) in POOL_KEYS: eff[m.group(1)] = m.group(2)
    if eff.get("pm") == "dynamic":
        try:
            mn, st, mx, ch = (int(eff[k]) for k in ("pm.min_spare_servers", "pm.start_servers", "pm.max_spare_servers", "pm.max_children"))
        except (KeyError, ValueError): die("mode dynamic butuh pm.start_servers, pm.min_spare_servers, pm.max_spare_servers, dan pm.max_children")
        if not (1 <= mn <= st <= mx <= ch): die("mode dynamic: min_spare <= start_servers <= max_spare <= max_children")
    if eff.get("pm") == "static" and "pm.max_children" not in eff: die("mode static butuh pm.max_children")
    shutil.copy2(p, bak); p.write_text(new)
    t = sh([str(php_home(v) / "sbin/php-fpm"), "-t"])
    if t.returncode:
        p.write_text(old); die("php-fpm -t gagal, dikembalikan: " + (t.stderr or t.stdout).strip()[-200:])
    if not restart_fpm(v):
        p.write_text(old); restart_fpm(v); die("FPM tidak menjawab setelah restart, dikembalikan")
    print(f"OK: {', '.join(f'{k}={x}' for k, x in pairs.items())} diterapkan ke FPM {v} (cadangan: {Path(bak).name})")


# ---------- composer ----------
def composer_status():
    inst = Path(COMPOSER).exists()
    ver, php = "", ""
    if inst:
        r = sh([COMPOSER, "--version", "--no-ansi"])
        m = re.search(r"Composer version (\S+)", r.stdout); ver = m.group(1) if m else ""
        m = re.search(r"PHP version (\S+)", r.stdout); php = m.group(1) if m else ""
    out = sh([BREW, "outdated", "--json=v2", "composer"]).stdout or "{}"
    try: newer = (json.loads(out).get("formulae") or [{}])[0].get("current_version", "")
    except (ValueError, IndexError, AttributeError): newer = ""
    print(json.dumps(dict(installed=inst, version=ver, php=php, outdated=bool(newer), latest=newer)))


def composer(a):
    if a.act == "status": return composer_status()
    if a.act == "install":
        if Path(COMPOSER).exists(): print("Composer sudah terpasang"); return
        sys.exit(stream([BREW, "install", "composer"]))
    if a.act == "update": sys.exit(stream([BREW, "upgrade", "composer"]))
    if a.act == "run":
        d, v = project(a.site); sys.exit(0 if run_step(a.cmd.replace("-", "_"), d, v) else 1)


# ---------- deploy ----------
def site_conf(name):
    if not NAME_RE.match(name or ""): die("nama situs tidak valid")
    if name in PROTECTED: die(f"situs sistem '{name}' tidak bisa di-deploy dari sini")
    p = SITES / f"{name}.conf"
    if not p.exists(): die(f"situs '{name}' tidak ada atau sedang dijeda")
    return p.read_text()


def project(name):
    """Folder proyek dari `root` nginx (satu tingkat di atas public/), harus di bawah ~/Developer. Versi PHP dari socket FPM."""
    t = site_conf(name)
    m = re.search(r"^\s*root\s+([^;\s]+);", t, re.M)
    if not m: die("situs ini tidak punya root (bukan situs PHP/statis)")
    root = Path(m.group(1)).resolve()
    d = root.parent if root.name == "public" else root
    base = (HOME / "Developer").resolve()
    if base not in d.parents: die("folder proyek harus di bawah ~/Developer")
    if not d.is_dir(): die("folder proyek tidak ada")
    v = re.search(r"php-fpm-dev-(8\.\d)\.sock", t)
    return d, (v.group(1) if v else None)


def node_pm(d):
    if (d / "pnpm-lock.yaml").exists(): return "pnpm"
    if (d / "package-lock.json").exists(): return "npm"
    return None


def pkg_script(d, name):
    try: return name in (json.loads((d / "package.json").read_text()).get("scripts") or {})
    except (OSError, ValueError): return False


def available(d, v):
    s = []
    if (d / ".git").exists(): s.append(("git_pull", "Tarik perubahan terbaru (git pull --ff-only)"))
    if (d / "composer.json").exists() and Path(COMPOSER).exists():
        s += [("composer_install", "composer install"), ("composer_install_nodev", "composer install --no-dev -o"), ("composer_update", "composer update"), ("dump_autoload", "composer dump-autoload -o")]
    if node_pm(d): s.append(("node_install", f"{node_pm(d)} install (sesuai lockfile)"))
    if node_pm(d) and pkg_script(d, "build"): s.append(("node_build", f"{node_pm(d)} run build"))
    if (d / "artisan").exists() and v:
        s += [("artisan_migrate", "php artisan migrate --force"), ("artisan_optimize", "php artisan optimize")]
    if v: s.append(("fpm_restart", f"Mulai ulang FPM {v} (bersihkan opcache)"))
    return s


def deploy_info(name):
    d, v = project(name)
    info = dict(site=name, dir=str(d), php=v, steps=[dict(id=i, label=l) for i, l in available(d, v)], git=None)
    if (d / ".git").exists():
        g = lambda *x: sh(["/usr/bin/git", "-C", str(d), *x]).stdout.strip()
        info["git"] = dict(branch=g("rev-parse", "--abbrev-ref", "HEAD"), commit=g("log", "-1", "--format=%h %s")[:120], dirty=bool(g("status", "--porcelain")),
                           remote=bool(g("remote")))
    print(json.dumps(info))


def run_step(step, d, v):
    genv = dict(ENV, GIT_TERMINAL_PROMPT="0", GIT_SSH_COMMAND="ssh -o BatchMode=yes", COMPOSER_NO_INTERACTION="1", COMPOSER_ALLOW_SUPERUSER="0")
    phpx = php_bin(v) if v else "/opt/homebrew/bin/php"
    pm = node_pm(d)
    cmds = {
        "git_pull": ["/usr/bin/git", "-C", str(d), "pull", "--ff-only"],
        "composer_install": [phpx, COMPOSER, "install", "--no-interaction", "--prefer-dist"],
        "composer_install_nodev": [phpx, COMPOSER, "install", "--no-interaction", "--prefer-dist", "--no-dev", "-o"],
        "composer_update": [phpx, COMPOSER, "update", "--no-interaction"],
        "dump_autoload": [phpx, COMPOSER, "dump-autoload", "-o", "--no-interaction"],
        "validate": [phpx, COMPOSER, "validate", "--no-interaction"],
        "artisan_migrate": [phpx, "artisan", "migrate", "--force"],
        "artisan_optimize": [phpx, "artisan", "optimize"],
    }
    if pm == "pnpm": cmds["node_install"] = [MISE, "exec", "--", "pnpm", "install", "--frozen-lockfile"]; cmds["node_build"] = [MISE, "exec", "--", "pnpm", "run", "build"]
    if pm == "npm": cmds["node_install"] = [MISE, "exec", "--", "npm", "ci"]; cmds["node_build"] = [MISE, "exec", "--", "npm", "run", "build"]
    print(f"== {step} ==", flush=True)
    if step == "fpm_restart":
        if not v: print("situs ini tidak memakai FPM"); return False
        ok = restart_fpm(v); print("FPM dimulai ulang" if ok else "FPM tidak menjawab"); return ok
    if step not in cmds: print(f"langkah tidak tersedia untuk proyek ini: {step}"); return False
    if step in ("git_pull",) and not (d / ".git").exists(): print("bukan repo git"); return False
    rc = stream(cmds[step], cwd=str(d), env=genv, stdin=subprocess.DEVNULL)
    print(f"-- {step}: {'ok' if rc == 0 else 'gagal (kode ' + str(rc) + ')'}", flush=True)
    return rc == 0


def deploy(a):
    if a.act == "info": return deploy_info(a.site)
    d, v = project(a.site)
    ok_ids = {i for i, _ in available(d, v)}
    steps = [s for s in a.steps.split(",") if s]
    if not steps or len(steps) > 8: die("pilih 1-8 langkah")
    for s in steps:
        if s not in ok_ids: die(f"langkah '{s}' tidak tersedia untuk proyek ini (tersedia: {', '.join(sorted(ok_ids)) or '-'})")
    for s in steps:
        if not run_step(s, d, v): die(f"berhenti di langkah '{s}'")
    print("OK: deploy selesai")


# ---------- backup ----------
STAGING = HOME / "Backups/staging"


BK_LABEL = "com.macminiops.backup"
BK_PLIST = HOME / "Library/LaunchAgents" / f"{BK_LABEL}.plist"
BK_CONF = HOME / ".config/macminiops/backup.conf"
RESTORE_DIR = HOME / "Backups/restore"
BK_NAME = re.compile(r"^\d{8}-\d{6}$")
PARTS = {"developer": "developer.tar.gz", "dotfiles": "dotfiles.tar.gz"}
PATH_OK = re.compile(r"^[A-Za-z0-9._@+ /-]{1,300}$")


def bk_archive(name, part):
    if not BK_NAME.match(name or ""): die("nama backup tidak valid")
    if part not in PARTS: die(f"bagian: {', '.join(PARTS)}")
    f = STAGING / name / PARTS[part]
    if not f.is_file(): die("arsip tidak ada")
    return f


def bk_config(a):
    import plistlib
    if a.cact == "get":
        t, keep = "02:30", 7
        try:
            pl = plistlib.loads(BK_PLIST.read_bytes()); c = pl["StartCalendarInterval"]; t = f"{c['Hour']:02d}:{c['Minute']:02d}"
        except (OSError, KeyError, ValueError): pass
        if BK_CONF.exists():
            m = re.search(r"^KEEP=(\d{1,3})$", BK_CONF.read_text(), re.M)
            if m: keep = int(m.group(1))
        print(json.dumps(dict(time=t, keep=keep))); return
    tm = re.fullmatch(r"([01]\d|2[0-3]):([0-5]\d)", a.time or "")
    if not tm: die("jam format HH:MM (00:00-23:59)")
    if not (1 <= a.keep <= 60): die("simpan 1-60 backup")
    BK_CONF.parent.mkdir(parents=True, exist_ok=True)
    BK_CONF.write_text(f"KEEP={a.keep}\n"); os.chmod(BK_CONF, 0o600)
    pl = plistlib.loads(BK_PLIST.read_bytes())
    shutil.copy2(BK_PLIST, f"{BK_PLIST}.bak.{time.strftime('%Y%m%d-%H%M%S')}")
    pl["StartCalendarInterval"] = {"Hour": int(tm.group(1)), "Minute": int(tm.group(2))}
    BK_PLIST.write_bytes(plistlib.dumps(pl))
    uid = os.getuid()
    sh(["/bin/launchctl", "bootout", f"gui/{uid}/{BK_LABEL}"])
    r = sh(["/bin/launchctl", "bootstrap", f"gui/{uid}", str(BK_PLIST)])
    if r.returncode: die("launchctl gagal: " + (r.stderr or r.stdout).strip()[-200:])
    print(f"OK: backup harian pukul {a.time}, simpan {a.keep} terakhir")


def bk_ls(a):
    f = bk_archive(a.name, a.part)
    pre = (a.prefix or "").strip("/")
    if pre and (not PATH_OK.match(pre) or ".." in pre.split("/")): die("path tidak valid")
    r = subprocess.run(["/usr/bin/tar", "-tzf", str(f)], capture_output=True, text=True)
    if r.returncode: die("arsip tidak terbaca")
    seen = {}
    for l in r.stdout.splitlines():
        l = l.strip("/")
        if pre and not (l == pre or l.startswith(pre + "/")): continue
        rest = l[len(pre):].lstrip("/") if pre else l
        if not rest: continue
        head, _, tail = rest.partition("/")
        if any(x in head for x in ("node_modules", ".git")) and tail: seen.setdefault(head, True)
        seen[head] = seen.get(head, False) or bool(tail)
    ents = sorted(seen.items(), key=lambda kv: (not kv[1], kv[0].lower()))[:500]
    print(json.dumps(dict(prefix=pre, entries=[dict(name=n, dir=d) for n, d in ents])))


def bk_extract(a):
    f = bk_archive(a.name, a.part)
    p = (a.path or "").strip("/")
    if not p or not PATH_OK.match(p) or ".." in p.split("/") or p.startswith("-"): die("path tidak valid")
    RESTORE_DIR.mkdir(parents=True, exist_ok=True); os.chmod(RESTORE_DIR, 0o700)
    dest = RESTORE_DIR / f"{a.name}-{a.part}-{time.strftime('%H%M%S')}"
    dest.mkdir(mode=0o700)
    r = subprocess.run(["/usr/bin/tar", "-xzf", str(f), "-C", str(dest), "--", p], capture_output=True, text=True)
    if r.returncode: shutil.rmtree(dest, ignore_errors=True); die("ekstrak gagal: " + (r.stderr or "").strip()[-200:])
    n = sum(1 for _ in dest.rglob("*"))
    print(f"OK: {n} entri diekstrak ke {dest} (berkas asli tidak disentuh; salin manual bila perlu)")


def backup(a):
    if a.act == "config": return bk_config(a)
    if a.act == "ls": return bk_ls(a)
    if a.act == "extract": return bk_extract(a)
    if a.act == "run": sys.exit(stream([str(OPS / "scripts/backup.sh")]))
    rows = []
    for d in sorted(STAGING.glob("20*"), reverse=True)[:14] if STAGING.exists() else []:
        if not d.is_dir(): continue
        fs = [f for f in d.iterdir() if f.is_file()]
        rows.append(dict(name=d.name, at=int(d.stat().st_mtime), size=sum(f.stat().st_size for f in fs), files=sorted(f.name for f in fs)))
    print(json.dumps(dict(backups=rows, offsite=(HOME / ".config/macminiops/offsite").exists())))


# ---------- dbcfg: pengaturan server MySQL dan Redis (berkas milik panel, bukan my.cnf/redis.conf asli) ----------
MY_SIZE = re.compile(r"^\d{1,5}[MG]$")
MYSQL_KEYS = {
    "max_connections": (lambda s: re.fullmatch(r"\d{2,4}", s) and 10 <= int(s) <= 2000, "10-2000"),
    "innodb_buffer_pool_size": (lambda s: MY_SIZE.match(s) and 64 <= (int(s[:-1]) * (1024 if s[-1] == "G" else 1)) <= 8192, "64M-8G, mis. 512M"),
    "max_allowed_packet": (lambda s: MY_SIZE.match(s) and 1 <= (int(s[:-1]) * (1024 if s[-1] == "G" else 1)) <= 1024, "1M-1G, mis. 64M"),
    "slow_query_log": (lambda s: s in ("0", "1"), "0 atau 1"),
    "long_query_time": (lambda s: re.fullmatch(r"\d{1,2}(\.\d)?", s) and float(s) <= 60, "detik, 0-60"),
}
MYSQL_FILE = Path("/opt/homebrew/etc/my.cnf.d/20-macpanel.cnf")
MYSQL_SLOW = "/opt/homebrew/var/mysql/macpanel-slow.log"
REDIS_KEYS = {
    "maxmemory": (lambda s: s == "0" or re.fullmatch(r"\d{1,5}(mb|gb)", s), "0 (tanpa batas) atau mis. 256mb, 2gb"),
    "maxmemory-policy": (lambda s: s in ("noeviction", "allkeys-lru", "volatile-lru", "allkeys-lfu", "volatile-lfu", "allkeys-random", "volatile-ttl"), "noeviction, allkeys-lru, volatile-lru, ..."),
    "appendonly": (lambda s: s in ("yes", "no"), "yes atau no"),
    "save": (lambda s: s in ("off", "default"), "off atau default (3600 1 300 100 60 10000)"),
}
REDIS_CONF = Path("/opt/homebrew/etc/redis.conf")
REDIS_INC = Path("/opt/homebrew/etc/redis.d/macpanel.conf")


def _kv_file(path, keys):
    cur = {}
    if path.exists():
        for l in path.read_text().splitlines():
            m = re.match(r"^([a-z_-]+)\s+(.*?)\s*$", l) if path == REDIS_INC else re.match(r"^([a-z_]+)\s*=\s*(.*?)\s*$", l)
            if m and m.group(1) in keys: cur[m.group(1)] = m.group(2).strip('"')
    return cur


def mysql_live(k):
    root = {}
    for ln in (HOME / ".config/macminiops/db.env").read_text().splitlines():
        if "=" in ln and not ln.startswith("#"): a, b = ln.split("=", 1); root[a.strip()] = b.strip().strip("'\"")
    e = dict(ENV, MYSQL_PWD=root.get("MYSQL_ROOT_PASSWORD", ""))
    r = subprocess.run(["/opt/homebrew/opt/mysql@8.4/bin/mysql", "-h127.0.0.1", "-uroot", "-N", "-e", f"SELECT @@{k}"], env=e, text=True, capture_output=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def redis_live(k):
    r = sh(["/opt/homebrew/bin/redis-cli", "-h", "127.0.0.1", "CONFIG", "GET", k])
    l = r.stdout.splitlines()
    return l[1] if r.returncode == 0 and len(l) >= 2 else ""


def dbcfg(a):
    eng = a.engine
    keys, path = (MYSQL_KEYS, MYSQL_FILE) if eng == "mysql" else (REDIS_KEYS, REDIS_INC)
    live = mysql_live if eng == "mysql" else redis_live
    if a.act == "get":
        cur = _kv_file(path, keys)
        print(json.dumps(dict(engine=eng, keys=[dict(key=k, value=cur.get(k, ""), live=live(k), hint=h) for k, (_, h) in keys.items()])))
        return
    if a.act == "slow":
        if eng != "mysql": die("slow log hanya untuk MySQL")
        p = Path(MYSQL_SLOW)
        print("\n".join(p.read_text(errors="replace").splitlines()[-200:]) if p.exists() else "(log kosong; aktifkan slow_query_log)")
        return
    pairs = {}
    for kv in a.pairs:
        if "=" not in kv: die(f"format kunci=nilai: {kv!r}")
        k, val = kv.split("=", 1)
        if k not in keys: die(f"kunci tidak didukung: {k!r} (boleh: {', '.join(keys)})")
        if not keys[k][0](val): die(f"nilai {k} tidak valid ({keys[k][1]})")
        pairs[k] = val
    if not pairs: die("tidak ada nilai")
    cur = _kv_file(path, keys); cur.update(pairs)
    old = path.read_text() if path.exists() else None
    path.parent.mkdir(parents=True, exist_ok=True)
    if old is not None: shutil.copy2(path, f"{path}.bak.{time.strftime('%Y%m%d-%H%M%S')}")
    if eng == "mysql":
        body = "# Dikelola MacPanel (`lab dbcfg`). Jangan edit manual.\n[mysqld]\n" + "".join(f"{k} = {v}\n" for k, v in cur.items())
        if cur.get("slow_query_log") == "1": body += f"slow_query_log_file = {MYSQL_SLOW}\n"
        svc, port = "mysql@8.4", 3306
    else:
        body = "# Dikelola MacPanel (`lab dbcfg`). Jangan edit manual.\n"
        for k, v in cur.items():
            if k == "save": body += 'save ""\n' if v == "off" else "save 3600 1 300 100 60 10000\n"
            else: body += f"{k} {v}\n"
        svc, port = "redis", 6379
        inc = f"include {REDIS_INC}"
        t = REDIS_CONF.read_text()
        if inc not in t:
            shutil.copy2(REDIS_CONF, f"{REDIS_CONF}.bak.{time.strftime('%Y%m%d-%H%M%S')}")
            REDIS_CONF.write_text(t.rstrip("\n") + f"\n\n# MacPanel\n{inc}\n")
    path.write_text(body)
    sh([BREW, "services", "restart", svc])
    ok = False
    for _ in range(40):
        time.sleep(0.5)
        try:
            c = socket.create_connection(("127.0.0.1", port), 1); c.close(); ok = True; break
        except OSError: pass
    good = ok and all(live(k) != "" for k in pairs)
    if not good:
        if old is None: path.unlink(missing_ok=True)
        else: path.write_text(old)
        sh([BREW, "services", "restart", svc]); die(f"{eng} tidak naik dengan pengaturan baru; dikembalikan")
    print("OK: " + ", ".join(f"{k}={pairs[k]} (aktif: {live(k)})" for k in pairs))


# ---------- sys: proses, disk, keamanan, docker, statistik ----------
DEV_COMM = {"node", "php", "python", "python3", "go", "npm", "pnpm", "bun", "deno", "ruby", "vite", "esbuild", "tsx", "next-server", "composer", "java", "cargo"}
PROTECTED_COMM = {"panel", "launchd", "nginx", "mysqld", "postgres", "redis-server", "php-fpm", "dnsmasq", "sshd", "tailscaled", "Tailscale", "WindowServer", "loginwindow", "Finder", "netdata", "kernel_task"}


def ps_rows():
    r = sh(["/bin/ps", "-axo", "pid=,user=,pcpu=,pmem=,rss=,etime=,comm="])
    me = os.environ.get("USER", HOME.name); out = []
    for l in r.stdout.splitlines():
        f = l.split(None, 6)
        if len(f) < 7: continue
        pid, user, cpu, mem, rss, et, comm = f
        out.append(dict(pid=int(pid), user=user, cpu=float(cpu), mem=float(mem), rss_mb=round(int(rss) / 1024, 1), etime=et, name=os.path.basename(comm), mine=(user == me)))
    return out


def sys_procs():
    rows = [r for r in ps_rows() if r["mine"]]
    for r in rows: r["killable"] = r["name"] in DEV_COMM and r["name"] not in PROTECTED_COMM
    rows.sort(key=lambda r: (-r["cpu"], -r["rss_mb"]))
    print(json.dumps(dict(procs=rows[:40], total=len(rows))))


def sys_kill(pid):
    if pid <= 1: die("pid tidak valid")
    row = next((r for r in ps_rows() if r["pid"] == pid), None)
    if not row: die("proses tidak ada")
    if not row["mine"]: die("proses milik user lain")
    if row["name"] in PROTECTED_COMM or row["name"] not in DEV_COMM: die(f"'{row['name']}' bukan proses pengembangan; hentikan lewat halaman Aplikasi atau terminal")
    try: os.kill(pid, 15)
    except OSError as e: die(f"gagal: {e}")
    for _ in range(20):
        time.sleep(0.25)
        if not any(r["pid"] == pid for r in ps_rows()): print(f"OK: {row['name']} ({pid}) dihentikan (SIGTERM)"); return
    print(f"SIGTERM terkirim ke {row['name']} ({pid}) tetapi proses belum berhenti; coba lagi nanti")


def du_kb(path, timeout=40):
    try:
        r = subprocess.run(["/usr/bin/du", "-sk", str(path)], capture_output=True, text=True, timeout=timeout)
        return int(r.stdout.split()[0]) if r.stdout.strip() else None
    except (subprocess.TimeoutExpired, ValueError, IndexError): return None


def sys_disk():
    items = []
    base = HOME / "Developer"
    for p in sorted(base.iterdir()) if base.exists() else []:
        if p.is_dir() and not p.is_symlink(): items.append((f"Developer/{p.name}", p))
    for lab, p in (("Backups", HOME / "Backups"), ("Homebrew (Cellar)", Path("/opt/homebrew/Cellar")), ("mise (runtime)", HOME / ".local/share/mise")):
        if p.exists(): items.append((lab, p))
    rows = [dict(name=n, kb=du_kb(p)) for n, p in items[:60]]
    rows = sorted([r for r in rows if r["kb"] is not None], key=lambda r: -r["kb"])[:30]
    st = shutil.disk_usage("/System/Volumes/Data")
    print(json.dumps(dict(rows=rows, total=st.total, free=st.free)))


def sys_security():
    fw = sh(["/usr/libexec/ApplicationFirewall/socketfilterfw", "--getglobalstate"]).stdout.strip()
    stealth = sh(["/usr/libexec/ApplicationFirewall/socketfilterfw", "--getstealthmode"]).stdout.strip()
    sshcfg = ""
    for p in [Path("/etc/ssh/sshd_config")] + sorted(Path("/etc/ssh/sshd_config.d").glob("*.conf")) if Path("/etc/ssh").exists() else []:
        try: sshcfg += p.read_text(errors="replace") + "\n"
        except OSError: pass
    def opt(k, default):
        m = re.findall(rf"^\s*{k}\s+(\S+)", sshcfg, re.I | re.M)
        return (m[0] if m else default).lower()
    r = sh(["/usr/sbin/lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-F", "pcn"])
    ports, pid, cmd = {}, "", ""
    for l in r.stdout.splitlines():
        if l.startswith("p"): pid = l[1:]
        elif l.startswith("c"): cmd = l[1:]
        elif l.startswith("n"):
            addr, _, port = l[1:].rpartition(":")
            local = addr in ("127.0.0.1", "[::1]", "localhost")
            ports[(addr, port, cmd)] = dict(addr=addr, port=int(port) if port.isdigit() else 0, proc=cmd, exposed=not local)
    rows = sorted(ports.values(), key=lambda x: (not x["exposed"], x["port"]))
    ts = sh(["/usr/local/bin/tailscale", "status", "--self=true", "--peers=false"]) if Path("/usr/local/bin/tailscale").exists() else None
    print(json.dumps(dict(firewall=fw, stealth=stealth,
        ssh=dict(password_auth=opt("PasswordAuthentication", "yes (bawaan)"), root_login=opt("PermitRootLogin", "prohibit-password (bawaan)"), kbd_interactive=opt("KbdInteractiveAuthentication", "yes (bawaan)")),
        ports=rows[:80])))


def sys_docker():
    exe = shutil.which("docker", path=ENV["PATH"])
    if not exe: print(json.dumps(dict(installed=False))); return
    r = sh([exe, "ps", "--format", "{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"], timeout=15)
    if r.returncode: print(json.dumps(dict(installed=True, running=False, error=(r.stderr or "").strip()[-200:]))); return
    cs = [dict(zip(("name", "image", "status", "ports"), l.split("\t"))) for l in r.stdout.splitlines() if l.strip()]
    print(json.dumps(dict(installed=True, running=True, containers=cs)))


LOG_RE = re.compile(r'^(\S+) \S+ \S+ \[([^\]]+)\] "(\S+) (\S+)[^"]*" (\d{3}) (\d+|-)')
LOGD = Path("/opt/homebrew/var/log/nginx/sites")


def sys_stats(name):
    if not re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?", name or ""): die("nama situs tidak valid")
    f = LOGD / f"{name}.log"
    if not f.exists(): print(json.dumps(dict(exists=False))); return
    size = f.stat().st_size
    with open(f, "rb") as fh:
        fh.seek(max(0, size - 8 * 1024 * 1024)); data = fh.read().decode("utf-8", "replace")
    lines = data.splitlines()[1:] if size > 8 * 1024 * 1024 else data.splitlines()
    from collections import Counter
    days, status, paths, ips = Counter(), Counter(), Counter(), Counter()
    total_b = n = 0
    for l in lines[-300000:]:
        m = LOG_RE.match(l)
        if not m: continue
        ip, ts, _meth, path, code, b = m.groups()
        n += 1; days[ts[:11]] += 1; status[code[0] + "xx"] += 1; paths[path.split("?")[0][:80]] += 1; ips[ip] += 1
        total_b += int(b) if b.isdigit() else 0
    ds = sorted(days.items(), key=lambda kv: time.strptime(kv[0], "%d/%b/%Y"))[-14:]
    print(json.dumps(dict(exists=True, requests=n, bytes=total_b, days=[dict(day=k, n=v) for k, v in ds], status=dict(status),
                          paths=[dict(path=k, n=v) for k, v in paths.most_common(10)], ips=[dict(ip=k, n=v) for k, v in ips.most_common(8)], note=f"dari {len(lines)} baris terakhir log")))


def sysx(a):
    if a.act == "procs": return sys_procs()
    if a.act == "kill": return sys_kill(a.pid)
    if a.act == "disk": return sys_disk()
    if a.act == "security": return sys_security()
    if a.act == "docker": return sys_docker()
    if a.act == "stats": return sys_stats(a.name)


def main():
    ap = argparse.ArgumentParser(prog="lab"); top = ap.add_subparsers(dest="mod", required=True)
    e = top.add_parser("ext").add_subparsers(dest="act", required=True)
    q = e.add_parser("list"); q.add_argument("php")
    for x in ("install", "remove", "enable", "disable"): q = e.add_parser(x); q.add_argument("php"); q.add_argument("name")
    i = top.add_parser("ini").add_subparsers(dest="act", required=True)
    q = i.add_parser("get"); q.add_argument("php"); q = i.add_parser("set"); q.add_argument("php"); q.add_argument("pairs", nargs="+")
    c = top.add_parser("composer").add_subparsers(dest="act", required=True)
    for x in ("status", "install", "update"): c.add_parser(x)
    q = c.add_parser("run"); q.add_argument("site"); q.add_argument("cmd", choices=["install", "install-nodev", "update", "dump-autoload", "validate"])
    d = top.add_parser("deploy").add_subparsers(dest="act", required=True)
    d.add_parser("info").add_argument("site"); q = d.add_parser("run"); q.add_argument("site"); q.add_argument("steps")
    sy = top.add_parser("sys").add_subparsers(dest="act", required=True)
    for x in ("procs", "disk", "security", "docker"): sy.add_parser(x)
    sy.add_parser("kill").add_argument("pid", type=int); sy.add_parser("stats").add_argument("name")
    dc = top.add_parser("dbcfg").add_subparsers(dest="act", required=True)
    for x in ("get", "slow"): q = dc.add_parser(x); q.add_argument("engine", choices=["mysql", "redis"])
    q = dc.add_parser("set"); q.add_argument("engine", choices=["mysql", "redis"]); q.add_argument("pairs", nargs="+")
    b = top.add_parser("backup").add_subparsers(dest="act", required=True); b.add_parser("list"); b.add_parser("run")
    q = b.add_parser("config"); q.add_argument("cact", choices=["get", "set"]); q.add_argument("--time"); q.add_argument("--keep", type=int, default=7)
    q = b.add_parser("ls"); q.add_argument("name"); q.add_argument("part"); q.add_argument("prefix", nargs="?", default="")
    q = b.add_parser("extract"); q.add_argument("name"); q.add_argument("part"); q.add_argument("path")
    a = ap.parse_args()
    if a.mod == "ext": ext_list(a.php) if a.act == "list" else ext_act(a)
    elif a.mod == "ini": ini_get(a.php) if a.act == "get" else ini_set(a)
    elif a.mod == "composer": composer(a)
    elif a.mod == "deploy": deploy(a)
    elif a.mod == "backup": backup(a)
    elif a.mod == "dbcfg": dbcfg(a)
    elif a.mod == "sys": sysx(a)


if __name__ == "__main__":
    main()
