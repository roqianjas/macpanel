        import json as _j
        cred = _j.loads(need(lab("db", "creds", n, "--engine", "mysql"), "baca kredensial"))
        kv = {"DB_HOST": "127.0.0.1", "DB_PORT": "3306", "DB_DATABASE": n, "DB_USERNAME": cred["DB_USERNAME"], "DB_PASSWORD": cred["DB_PASSWORD"]}
