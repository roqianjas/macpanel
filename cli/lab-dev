    dest = APPS_DIR / n
    if dest.exists() or site_exists(n): die("nama sudah dipakai (folder atau situs)")
    APPS_DIR.mkdir(parents=True, exist_ok=True)
    dbs = []
    try:
        print("== database ==", flush=True)
