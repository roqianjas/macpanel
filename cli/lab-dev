            ef = dest / ".env"
            ef.write_text(set_env_kv(ef.read_text(), dict(kv, DB_CONNECTION="mysql", APP_URL=f"https://{n}.lab", SESSION_DRIVER="file", CACHE_STORE="file", QUEUE_CONNECTION="sync")))
