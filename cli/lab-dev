APPS_DIR = ROOT / "wwwroot"
LABBIN = str(OPS / "scripts/lab")
NAME_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?$")


def lab(*args, inp=None, timeout=900):
    r = subprocess.run([LABBIN, *args], env=ENV, text=True, capture_output=True, input=inp, timeout=timeout)
    return r


def need(r, what):
    if r.returncode: die(f"{what} gagal: " + ((r.stderr or r.stdout).strip()[-300:] or "tanpa pesan"))
    return r.stdout


def site_exists(n): return (OPS / "nginx/sites" / f"{n}.conf").exists() or (OPS / "nginx/sites" / f"{n}.conf.disabled").exists()


def set_env_kv(text, kv):
    """Ganti/aktifkan baris KEY=... (termasuk yang dikomentari); tambahkan bila tidak ada."""
    for k, v in kv.items():
        val = v if re.fullmatch(r"[A-Za-z0-9_./:@+-]*", v) else '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'
        pat = re.compile(rf"^#?\s*{re.escape(k)}=.*$", re.M)
        text = pat.sub(lambda m: f"{k}={val}", text, count=1) if pat.search(text) else text.rstrip("\n") + f"\n{k}={val}\n"
    return text


def rollback(dest, dbs):
    if dest and dest.exists() and APPS_DIR in dest.parents: shutil.rmtree(dest, ignore_errors=True)
    for n, eng in dbs: lab("db", "drop", n, "--engine", eng, inp=n + "\n")


