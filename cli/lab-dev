def site_clone(a):
    src, dst = a.src, a.dst
    if not NAME_RE.fullmatch(dst or ""): die("nama tujuan: huruf kecil, angka, tanda hubung (maks 30)")
    if dst in ("home", "panel", "db", "nginx", "kuma", "stats", "dev", "mysql", "postgres", "root"): die("nama itu dicadangkan")
    d, v = project(src)
    if dst == src or site_exists(dst) or (APPS_DIR / dst).exists(): die("nama tujuan sudah dipakai")
    if APPS_DIR in d.parents or d.parent == APPS_DIR or True:
        pass
    out = APPS_DIR / dst
    APPS_DIR.mkdir(parents=True, exist_ok=True)
    dbs = []
    try:
        print("== salin berkas (tanpa .git, node_modules, log) ==", flush=True)
        r = subprocess.run(["/usr/bin/rsync", "-a", "--exclude=.git", "--exclude=node_modules", "--exclude=storage/logs/*", "--exclude=.env.bak.*", "--exclude=*.log", f"{d}/", f"{out}/"], env=ENV, text=True, capture_output=True)
        if r.returncode: die("salin gagal: " + (r.stderr or "").strip()[-200:])
        envf = out / ".env"
        if envf.exists():
            text = envf.read_text()
            m = re.search(r"^DB_DATABASE=(.*)$", text, re.M)
            conn = (re.search(r"^DB_CONNECTION=(\S+)", text, re.M) or [None, "mysql"])[1]
            eng = "pgsql" if conn in ("pgsql", "postgres", "postgresql") else "mysql"
            if m and m.group(1).strip().strip("\"'"):
                srcdb = m.group(1).strip().strip("\"'")
                print("== database baru untuk kloning ==", flush=True)
                need(lab("db", "create", dst, "--engine", eng), "buat database"); dbs.append((dst, eng))
                cred = json.loads(need(lab("db", "creds", dst, "--engine", eng), "baca kredensial"))
                if a.with_db:
                    if NAME_RE.fullmatch(srcdb) and lab("db", "users", srcdb, "--engine", eng).returncode == 0:
                        o = need(lab("db", "dump", srcdb, "--engine", eng), "dump database sumber")
                        f = o.split("OK:")[1].split("(")[0].strip()
                        nf = str(Path(f).with_name(Path(f).name.replace(f"{srcdb}-{eng}-", f"{dst}-{eng}-", 1)))
                        os.rename(f, nf); f = nf  # restore hanya menerima dump bernama sesuai database tujuan
                        need(lab("db", "restore", dst, "--engine", eng, "--file", f), "pulihkan ke database baru")
                        try: os.remove(f)
                        except OSError: pass
                    else: print("catatan: database sumber bukan database proyek lab; hanya database kosong dibuat")
                kv = {"DB_DATABASE": dst, "DB_USERNAME": cred["DB_USERNAME"], "DB_PASSWORD": cred["DB_PASSWORD"], "DB_HOST": "127.0.0.1", "APP_URL": f"https://{dst}.lab"}
                envf.write_text(set_env_kv(text, kv)); os.chmod(envf, 0o600)
            else:
                envf.write_text(set_env_kv(text, {"APP_URL": f"https://{dst}.lab"})) if "APP_URL=" in text else None
        root = out / "public" if (d / "public").is_dir() else out
        args = ["site", "add", dst, str(root)] + (["--php", v] if v else [])
        need(lab(*args), "tambah situs")
    except SystemExit:
        rollback(out, dbs); print("dibatalkan: salinan dan database yang baru dibuat dibersihkan"); raise
    print(f"OK: {src} dikloning ke {dst} ({out}). Buka https://{dst}.lab. Database kloning terpisah dari sumber (.env sudah diarahkan ke database baru).")


